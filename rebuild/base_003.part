.smart-report-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}
.copy-count-select{height:30px;width:76px;padding:0 26px 0 10px}
.compact-copy-list{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));gap:7px}
.compact-copy-list .copy-option{grid-template-columns:108px minmax(0,1fr);padding:8px 9px}
@media(max-width:1050px){.smart-query-box{grid-template-columns:40px minmax(0,1fr)}.smart-query-box .btn{grid-column:2;justify-self:end}.smart-suggestions,.smart-disclaimer{padding-left:52px}}


/* v24: customer-first scope, employee assignment, preview drag sorting, latest send time */
.audience-step-panel{max-width:1040px}
.employee-scope-card{margin-top:16px}
.employee-scope-card .surface-hd{padding:14px 16px}
.employee-scope-card .surface-bd{padding:12px 16px}
.audience-source-switch{margin-top:2px}
.send-mode-list{display:grid;gap:10px;margin-top:12px}
.send-mode-option{border:1px solid var(--line);border-radius:9px;background:#fff;padding:11px 12px;display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer}
.send-mode-option:has(input[type="radio"]:checked){border-color:#a9c6f9;background:#f8fbff}
.send-mode-main{display:flex;align-items:center;gap:10px;min-width:180px}
.send-mode-main input{accent-color:var(--brand)}
.send-mode-main div{display:grid;gap:2px}
.send-mode-main b{font-size:13px}
.send-mode-main span{font-size:12px;color:#7d889a}
.time-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.time-card-meta{display:flex;align-items:center;gap:8px}
.time-rule-link{border:0;background:transparent;color:var(--brand);font-size:12px;cursor:pointer;padding:2px 0}
.time-rule-link:hover{text-decoration:underline}
.time-rule-panel{margin-top:10px;padding-top:10px;border-top:1px dashed #d7e2f4}
.time-rule-panel.hidden{display:none}
.time-rule-row{display:grid;grid-template-columns:110px 128px minmax(0,1fr);align-items:center;gap:10px}
.time-rule-label{font-size:12px;font-weight:600;color:#475467}
.time-rule-panel .input{height:34px;padding:6px 9px}
.time-rule-note{font-size:12px;line-height:1.55;color:#7b8798}
.smart-time-status{margin-top:7px;font-size:12px;color:#667085}
.custom-time-input{width:210px;margin-left:auto}
.phone-title-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.phone-title-row .phone-title{margin-bottom:0}
.moment-images.sortable .moment-image-item{cursor:grab;position:relative;border-radius:3px;overflow:hidden}
.moment-images.sortable .moment-image-item:active{cursor:grabbing}
.moment-image-item.dragging{opacity:.45;outline:2px solid var(--brand)}
.moment-image-item.drag-over{outline:2px solid var(--brand);outline-offset:1px}
.moment-image-item .drag-mark{position:absolute;right:4px;top:4px;width:22px;height:22px;border-radius:5px;background:rgba(17,24,39,.72);color:#fff;display:grid;place-items:center;font-size:12px;z-index:2;letter-spacing:-1px}
.moment-image-item .moment-image{display:block}
@media(max-width:1200px){.time-rule-row{grid-template-columns:100px 120px minmax(0,1fr)}.review-layout{grid-template-columns:minmax(0,1fr) 350px}}


.reference-strip{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.ref-tile{width:96px;height:96px;border:1px dashed var(--line);border-radius:14px;background:#f8fafc;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;color:var(--sub);cursor:pointer;text-align:center;padding:8px}
.ref-tile.filled{border-style:solid;background:#eef2ff;cursor:default;padding:0}
.ref-thumb{width:100%;height:100%;object-fit:cover;display:block}
.ref-tile.add-more{background:#fff}
.slot-col-wide{flex:1.2}
.slot-preview-col{max-width:260px}
.slot-message{font-size:12px;color:var(--sub);margin-left:8px}
.result-image{width:100%;height:100%;object-fit:cover;border-radius:12px;display:block}


/* v3.2 review fixes */
.compact-generator{grid-template-rows:auto auto 78px auto auto minmax(0,1fr)}
.slot-body{grid-template-columns:minmax(0,1fr) 260px;gap:18px}
.slot-col-wide .slot-actions{justify-content:flex-start}
.slot-preview-col{max-width:none}
.ref-tile{position:relative;width:104px;height:96px}
.ref-tile.uploader b{font-size:13px;white-space:nowrap}
.moment-image-item{position:relative}
.moment-image-item .drag-mark{display:none}
.moment-images.sortable .moment-image-item .drag-mark{display:grid}
.ref-remove{position:absolute;right:5px;top:5px;width:22px;height:22px;border:0;border-radius:50%;background:rgba(17,24,39,.72);color:#fff;font-size:16px;line-height:20px;display:grid;place-items:center;cursor:pointer;opacity:0;transition:opacity .15s}
.ref-tile.filled:hover .ref-remove{opacity:1}
#step4Panel .review-left{overflow:visible}
@media(max-width:980px){.slot-body{grid-template-columns:1fr}.slot-preview-col{max-width:none}}


/* v3.4 reviewed image workflow */
.upload-option-row{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:14px}.checkbox-line{display:inline-flex;align-items:center;gap:8px;color:#344054}.category-inline{display:inline-flex;align-items:center;gap:8px;color:#475467;font-size:13px}.local-upload-list{display:grid;gap:10px;max-height:430px;overflow:auto;padding-right:2px}.local-upload-item{display:grid;grid-template-columns:76px minmax(0,1fr);gap:12px;align-items:center;padding:10px;border:1px solid var(--line);border-radius:10px;background:#fbfcfe}.local-upload-thumb{width:76px;height:76px;border-radius:9px;object-fit:cover;border:1px solid #dce5f1;background:#eef2ff}.local-upload-fields{display:grid;gap:7px}.upload-title-row{display:grid;grid-template-columns:minmax(0,1fr) 48px;gap:8px;align-items:center}.upload-title-count{font-size:12px;color:#8a95a6;text-align:right}.material-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px}.material-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-height:440px;overflow:auto;padding-right:2px}.material-card{position:relative;border:1px solid var(--line);border-radius:10px;padding:8px;background:#fff;cursor:pointer}.material-card:hover{border-color:#afc5ec}.material-card.active{border-color:var(--brand);box-shadow:0 0 0 2px rgba(50,120,246,.1);background:#fbfdff}.material-card img{width:100%;aspect-ratio:1;border-radius:8px;object-fit:cover;background:#eef2ff}.material-card-title{font-size:12px;font-weight:600;color:#344054;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.material-card-meta{font-size:12px;color:#8a95a6;margin-top:2px}.material-check{position:absolute;right:13px;top:13px;width:22px;height:22px;border-radius:50%;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:12px}.material-empty{grid-column:1/-1;min-height:180px;border:1px dashed #c8d4e4;border-radius:10px;background:#fbfcfe;display:grid;place-items:center;color:#8a95a6}.material-save-form{display:grid;grid-template-columns:170px minmax(0,1fr);gap:18px;align-items:start}.material-preview{width:170px;aspect-ratio:1;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:#f6f8fb}.material-preview img{width:100%;height:100%;object-fit:cover}.material-save-fields{display:grid;gap:16px}.material-save-fields label{display:grid;gap:7px;color:#475467;font-weight:600}.title-input-wrap{position:relative}.title-input-wrap .input{width:100%;padding-right:58px}.title-input-wrap span{position:absolute;right:10px;top:8px;font-size:12px;color:#98a2b3}
#step3Panel{max-width:1180px}.slot-list{display:grid;gap:14px}.image-slot{border-radius:12px}.slot-body{padding:16px;display:grid;grid-template-columns:254px minmax(320px,1fr) 250px;gap:18px;align-items:start}.slot-ref-col,.slot-prompt-col,.slot-preview-col{min-width:0}.ref-grid{display:grid;grid-template-columns:repeat(3,76px);grid-auto-rows:76px;gap:8px;min-height:160px;align-content:start}.ref-thumb-card,.ref-add-card{position:relative;width:76px;height:76px;border-radius:9px;overflow:hidden}.ref-thumb-card{border:1px solid #dce5f1;background:#eef2ff}.ref-thumb-card img{width:100%;height:100%;object-fit:cover}.ref-thumb-name{position:absolute;left:0;right:0;bottom:0;padding:3px 5px;background:linear-gradient(180deg,transparent,rgba(15,23,42,.78));color:#fff;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ref-remove{position:absolute;right:4px;top:4px;width:20px;height:20px;border:0;border-radius:50%;background:rgba(17,24,39,.78);color:#fff;display:grid;place-items:center;padding:0}.ref-add-card{border:1px dashed #c8d4e4;background:#fbfcfe;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;text-align:center;color:#63738b;cursor:pointer;padding:5px}.ref-add-card:hover{border-color:#9ebcf2;background:#f7faff}.ref-add-card b{font-size:11px}.ref-add-card .tiny{font-size:10px;line-height:1.3}.ref-tip{font-size:11px;color:#98a2b3;margin-top:6px}.slot-prompt{height:160px;resize:none}.prompt-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px}.prompt-actions .slot-message{margin:0;flex:1}.slot-preview-col .slot-result{height:196px}.preview-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:10px}.preview-actions .btn.small{padding:0 8px}.existing-upload-head{margin-bottom:12px}.existing-image-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.existing-drop-area{grid-column:1/-1;min-height:220px;border:1px dashed #c8d4e4;border-radius:12px;background:#fbfcfe;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#7d8b9f;cursor:pointer}.existing-drop-area:hover,.existing-add-tile:hover{border-color:#9ebcf2;background:#f7faff}.existing-add-tile{min-height:194px;border:1px dashed #c8d4e4;border-radius:10px;background:#fbfcfe;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#7d8b9f;cursor:pointer}.existing-image-card{border:1px solid var(--line);border-radius:10px;background:#fff;padding:10px;display:grid;gap:9px}.existing-image-title{font-size:12px;font-weight:600;color:#344054;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.existing-image-card .slot-result{height:162px}.existing-card-actions{display:flex;gap:7px;justify-content:flex-end;flex-wrap:wrap}.existing-card-actions .btn.small{padding:0 8px}
@media(max-width:1250px){.slot-body{grid-template-columns:238px minmax(300px,1fr) 230px}.ref-grid{grid-template-columns:repeat(3,70px);grid-auto-rows:70px;min-height:148px}.ref-thumb-card,.ref-add-card{width:70px;height:70px}.slot-preview-col .slot-result{height:182px}.material-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:980px){.slot-body{grid-template-columns:1fr}.ref-grid{grid-template-columns:repeat(3,76px)}.slot-preview-col .slot-result{height:240px}.material-grid,.existing-image-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.material-save-form{grid-template-columns:1fr}.material-preview{width:140px}}


/* v4.0 single-page form layout */
.ai-head{height:58px;padding:0 20px;background:#fff}
.form-workspace{padding:18px 20px 96px;background:#f5f7fa;overflow:auto}
.form-section{max-width:none!important;margin:0 0 18px;background:#fff;border:1px solid #edf0f5;border-radius:0;padding:0 20px 20px;box-shadow:none;scroll-margin-top:12px}
.form-section>.section-title{margin:0 -20px 16px;padding:14px 20px;border-bottom:1px solid #edf0f5;font-size:15px;font-weight:700}
.form-section>.section-desc{margin:-6px 0 16px;color:#7a8799}
.basic-section{padding-bottom:20px}
.basic-form-row{display:grid;grid-template-columns:92px minmax(320px,500px);gap:14px;align-items:center;padding:4px 0}
.form-field-label{font-weight:600;color:#475467;text-align:right}
.task-name-wrap{position:relative}.task-name-wrap .input{width:100%;padding-right:58px}.task-name-wrap span{position:absolute;right:10px;top:8px;font-size:12px;color:#98a2b3}
.form-section.error-section{border-color:#ef9a9e;box-shadow:0 0 0 2px rgba(229,72,77,.08)}
.form-section .surface{border-color:#e7ebf2}
#step1Panel .employee-scope-card{margin-bottom:14px!important}
#step1Panel .audience-source-panel{min-height:0}
#step2Panel,#step4Panel{height:auto!important;display:block!important;min-height:0!important}
#step2Panel .copy-source-panel,#step2Panel .compact-editor-box{height:auto;min-height:480px;overflow:visible}
#step2Panel .compact-generator{height:auto;min-height:480px}
#step2Panel .compact-final-editor{height:410px;min-height:410px;flex:none}
#step2Panel .compact-copy-list{min-height:220px;grid-auto-rows:minmax(82px,auto)}
#step3Panel{max-width:none!important}
#step4Panel .review-layout{grid-template-columns:minmax(0,1fr) 390px;align-items:start}
#step4Panel .review-left{overflow:visible;gap:14px}
.dispatch-summary{display:grid;gap:0}.dispatch-row{display:grid;grid-template-columns:90px minmax(0,1fr);gap:14px;padding:12px 0;border-bottom:1px solid #eef2f7}.dispatch-row:last-child{border-bottom:0}.dispatch-key{color:#667085}.dispatch-value{color:#1f2937;font-weight:500;display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.dispatch-value .review-audience-tags{margin-top:7px}
#step4Panel .phone-wrap{position:sticky;top:8px;height:auto}
#step4Panel .phone{height:520px;width:min(360px,100%)}
.form-bottom-bar{height:66px;justify-content:space-between}.bottom-status{font-size:12px;color:#8a95a6}
#step1Panel .audience-source-switch{margin-top:2px}
@media(max-width:1200px){#step4Panel .review-layout{grid-template-columns:minmax(0,1fr) 340px}#step4Panel .phone{width:330px}.compact-copy-layout{grid-template-columns:minmax(560px,1.35fr) minmax(320px,.75fr)}}
@media(max-width:980px){.form-workspace{padding:14px 14px 90px}.form-section{padding:0 14px 16px}.form-section>.section-title{margin:0 -14px 14px;padding:13px 14px}.basic-form-row{grid-template-columns:1fr}.form-field-label{text-align:left}.compact-copy-layout,#step4Panel .review-layout{grid-template-columns:1fr}#step4Panel .phone-wrap{position:static}#step4Panel .phone{width:min(360px,100%)}.form-bottom-bar{position:fixed}.bottom-status{display:none}}


/* v4.1 multi-moment SOP */
.sop-content-section{padding-bottom:20px}
.sop-content-layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:16px;align-items:start}
.sop-list-panel{position:sticky;top:8px;overflow:hidden}
.sop-list-head{padding:14px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;gap:10px}
.moment-list{padding:10px;display:grid;gap:8px;max-height:560px;overflow:auto}
.moment-list-item{border:1px solid var(--line);border-radius:9px;padding:10px;cursor:pointer;background:#fff;transition:.16s}
.moment-list-item:hover{border-color:#b9c9df;background:#fbfdff}.moment-list-item.active{border-color:var(--brand);background:#f7faff;box-shadow:0 0 0 2px rgba(50,120,246,.07)}
.moment-list-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.moment-list-index{font-size:12px;color:#667085;font-weight:700}.moment-list-name{font-weight:700;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.moment-list-time{font-size:12px;color:#7a8799;margin-top:4px}.moment-list-issue{font-size:11px;color:#c77800;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sop-list-actions{padding:12px;border-top:1px solid var(--line-soft);display:grid;gap:8px}.sop-list-actions .btn{width:100%}