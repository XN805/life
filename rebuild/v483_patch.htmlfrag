<style>
/* v4.8.3 — compact scope, four-column summaries, local preview sorting, lightweight submit */
#basicInfoPanel,#step1Panel .employee-scope-card,#step1Panel .audience-source-switch,#step1Panel .audience-source-panel{width:100%;max-width:900px;margin-left:0;margin-right:auto}
#basicInfoPanel{padding-bottom:18px}.basic-info-card{padding:18px}.basic-info-row{display:grid;grid-template-columns:92px minmax(280px,400px);gap:14px;align-items:center}.basic-info-row .form-field-label{text-align:right}.basic-info-row .title-input-wrap{width:100%}
#step1Panel>.section-desc,#step2Panel>.section-desc,.employee-scope-card .surface-hd .tiny,.moment-content-toolbar,.add-moment-divider,.moment-editor-head,.moment-name-subsection,.media-attachment-subsection{display:none!important}
#step1Panel .employee-scope-card{margin-top:0!important;margin-bottom:14px!important}#step1Panel .audience-source-switch{display:flex;margin-top:0;margin-bottom:14px}#step1Panel .audience-source-panel{min-height:0}.smart-audience-panel{padding:18px 20px}.audience-form{padding:18px 20px}
#step4Panel{display:none!important}.form-bottom-bar{justify-content:flex-end}.form-bottom-bar .bottom-status{display:none!important}
.moment-module-ident{grid-template-columns:auto minmax(120px,260px) auto!important;gap:8px!important}.rule-name-input{max-width:260px}.rule-name-count{display:none}.rule-name-input:focus+.rule-name-count{display:block}
.moment-module-summary{grid-template-columns:140px 150px minmax(260px,1fr) 90px!important;gap:16px;padding:14px 16px}.moment-module-summary>div{min-width:0}.summary-validity b,.summary-material b{font-weight:700}.summary-copy span:last-child{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.add-moment-zone{width:100%;max-width:none!important;display:flex;justify-content:flex-end;margin-top:16px!important;padding-top:0!important}.add-moment-entry{width:auto!important;min-height:36px!important;margin:0!important;padding:0 16px!important;border-style:solid!important;border-radius:6px!important;background:#fff!important;gap:6px!important}.add-moment-entry .plus{font-size:18px!important}.add-moment-entry span:last-child{display:block!important}.add-moment-entry b{font-size:13px!important}.add-moment-entry small{display:none!important}
.image-step-head .tiny,.existing-upload-head .tiny,.moment-schedule-subsection>.moment-subsection-title>.tiny{display:none!important}
.schedule-config-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.schedule-config-block{min-width:0;padding:14px;border:1px solid var(--line);border-radius:10px;background:#fff}.schedule-config-block .moment-subsection-title{margin-bottom:10px}.schedule-config-block .moment-time-options{grid-template-columns:repeat(2,minmax(0,1fr))!important}.validity-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.validity-option{min-height:74px;border:1px solid #d7deea;border-radius:9px;padding:11px;display:flex;gap:9px;align-items:flex-start;cursor:pointer;background:#fff}.validity-option:has(input:checked){border-color:#a9c7ff;background:#f7faff}.validity-option input{accent-color:var(--brand);margin-top:3px}.validity-option span{display:grid;gap:2px}.validity-option small{font-size:12px;color:#7a8799}.custom-validity-input{width:100%;margin-top:10px}.schedule-action-row{display:flex;justify-content:flex-end;margin-top:16px}
.material-type-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.material-type-card{border:1px solid var(--line);border-radius:10px;background:#fff;padding:17px;text-align:left;display:grid;grid-template-columns:42px 1fr;grid-template-rows:auto auto;column-gap:12px;cursor:pointer}.material-type-card:hover{border-color:#a9c7ff;background:#f8fbff}.material-type-icon{grid-row:1/3;width:42px;height:42px;border-radius:9px;background:var(--brand-soft);color:var(--brand);display:grid;place-items:center;font-size:20px}.material-type-card small{font-size:12px;color:#7a8799;margin-top:3px}.existing-material-card{grid-column:1/-1;border:1px solid var(--line);border-radius:10px;padding:15px;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#fff}.existing-material-main{display:flex;align-items:center;gap:12px;min-width:0}.existing-material-icon{width:46px;height:46px;border-radius:10px;background:var(--brand-soft);color:var(--brand);display:grid;place-items:center;font-size:20px;flex:0 0 auto}.existing-material-info{display:grid;gap:3px;min-width:0}.existing-material-info b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.existing-material-actions{display:flex;gap:8px}
.preview-popover-mask{background:transparent!important;align-items:flex-start!important;justify-content:flex-start!important}.quick-preview-dialog{position:fixed;width:350px!important;max-height:none!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important}.preview-popover-close{position:absolute;right:-8px;top:-8px;width:28px;height:28px;border:1px solid #d8dee8;border-radius:50%;background:#fff;color:#667085;box-shadow:0 3px 10px rgba(15,23,42,.15);z-index:3}.quick-preview-phone{width:330px!important;height:540px!important;margin:0!important}.quick-preview-phone .moment{height:calc(100% - 60px)}.quick-preview-phone .moment-images.sortable .moment-image-item{cursor:grab;position:relative;border-radius:3px;overflow:hidden}.quick-preview-phone .moment-image-item.dragging{opacity:.45;outline:2px solid var(--brand)}.quick-preview-phone .moment-image-item.drag-over{outline:2px solid var(--brand);outline-offset:1px}.quick-preview-phone .drag-mark{display:none;position:absolute;right:4px;top:4px;width:22px;height:22px;border-radius:5px;background:rgba(17,24,39,.72);color:#fff;place-items:center;font-size:12px;z-index:2}.quick-preview-phone .moment-images.sortable .drag-mark{display:grid}.phone-material-card{margin-top:9px;border:1px solid #e1e6ef;border-radius:8px;background:#f7f9fc;padding:10px;display:flex;align-items:center;gap:9px}.phone-material-card .icon{width:36px;height:36px;border-radius:7px;background:#eaf2ff;color:var(--brand);display:grid;place-items:center}.phone-material-card .info{display:grid;gap:2px;min-width:0}.phone-material-card b{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.phone-material-card span{font-size:11px;color:#8a95a6}
.confirm-schedule-list{margin-top:14px;border:1px solid var(--line);border-radius:8px;overflow:hidden}.confirm-schedule-head,.confirm-schedule-row{display:grid;grid-template-columns:48px minmax(110px,1fr) 150px 140px;gap:12px;align-items:center;padding:10px 12px}.confirm-schedule-head{background:#f7f9fc;color:#667085;font-size:12px;font-weight:700}.confirm-schedule-row{border-top:1px solid var(--line-soft);font-size:13px}.confirm-schedule-row .name{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ref-grid-v483{display:grid;grid-template-columns:repeat(3,68px);gap:7px;margin-bottom:9px}.ref-card-v483,.ref-add-v483{width:68px;height:68px;border-radius:8px;overflow:hidden;position:relative}.ref-card-v483{border:1px solid #dce5f1}.ref-card-v483 img{width:100%;height:100%;object-fit:cover}.ref-add-v483{border:1px dashed #c8d4e4;background:#fbfcfe;display:grid;place-items:center;text-align:center;font-size:11px;color:#63738b}.ref-remove-v483{position:absolute;right:3px;top:3px;width:18px;height:18px;border:0;border-radius:50%;background:rgba(17,24,39,.75);color:#fff;padding:0}.ai-slot-v483{border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden}.ai-slot-head-v483{height:44px;padding:0 12px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;background:#fbfcfe}.ai-slot-body-v483{padding:13px;display:grid;grid-template-columns:220px minmax(260px,1fr) 220px;gap:14px}.ai-result-v483{height:180px;border:1px dashed #c8d4e4;border-radius:8px;background:#fbfcfe;display:grid;place-items:center;overflow:hidden;color:#8793a5}.ai-result-v483 img{width:100%;height:100%;object-fit:cover}.ai-actions-v483{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
@media(max-width:1050px){.schedule-config-grid{grid-template-columns:1fr}.ai-slot-body-v483{grid-template-columns:1fr 1fr}.ai-slot-body-v483>div:last-child{grid-column:1/-1}.moment-module-summary{grid-template-columns:1fr 1fr!important}.summary-copy{grid-column:1/-1}}
@media(max-width:680px){#basicInfoPanel,#step1Panel .employee-scope-card,#step1Panel .audience-source-switch,#step1Panel .audience-source-panel{max-width:none}.basic-info-row{grid-template-columns:1fr}.basic-info-row .form-field-label{text-align:left}.moment-module-summary{grid-template-columns:1fr!important}.summary-copy{grid-column:auto}.add-moment-zone{justify-content:stretch}.add-moment-entry{width:100%!important}.material-type-grid,.validity-options,.ai-slot-body-v483{grid-template-columns:1fr}.ai-slot-body-v483>div:last-child{grid-column:auto}.confirm-schedule-head,.confirm-schedule-row{grid-template-columns:38px minmax(100px,1fr) 115px}.confirm-schedule-head span:nth-child(4),.confirm-schedule-row span:nth-child(4){display:none}}
</style>
<script>
(()=>{
'use strict';
const $=id=>document.getElementById(id);
const q=(s,r=document)=>r.querySelector(s);
const qa=(s,r=document)=>[...r.querySelectorAll(s)];
const uid=p=>`${p}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`;
const escapeHtml=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const DRAFT_KEY='ai_moments_v4_8_3_reviewed';
const memoryStorage={};
const storage=(()=>{try{localStorage.setItem('__v483','1');localStorage.removeItem('__v483');return localStorage}catch{return{getItem:k=>memoryStorage[k]??null,setItem:(k,v)=>memoryStorage[k]=String(v),removeItem:k=>delete memoryStorage[k]}}})();
const nowLocal=()=>{const d=new Date(),pad=n=>String(n).padStart(2,'0');return`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`};
const formatDate=v=>{if(!v)return'未设置';const d=new Date(v);if(Number.isNaN(d.getTime()))return'未设置';return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`};
const templates={
 new:[['自然种草版','新到了一条夏天很适合穿的法式收腰连衣裙。\n\n不是那种一眼很夸张的款，但上身会显得人很干净，腰线也比较自然。日常出门、约会、通勤都能穿。\n\n想看上身效果和细节图的可以私聊我，我按你的身高体重帮你看尺码。'],['显瘦卖点版','这条新款连衣裙，我觉得最值得看的是版型。\n\n腰线收得刚好，不是勒出来的紧，而是自然把比例拉出来；裙摆对胯和腿也比较友好。\n\n最近想找一条显瘦但不紧绷的裙子，可以私聊我看图。'],['场景代入版','这条裙子很适合“不知道穿什么，但又想看起来有点精致”的时候。\n\n上班穿不会太隆重，下班约饭也不会太随便，配凉鞋、单鞋和小外套都可以。\n\n想看不同搭配效果的可以私聊我。']],
 double11:[['活动预热版','618活动快开始了，这次给老朋友准备了几款日常很好穿的单品。\n\n优惠不做复杂套路，想提前看款和尺码建议，可以先私聊我。'],['利益说明版','618活动已开启：部分新品参与满减，老客还有专属权益。\n\n具体到手价和适合尺码可以发我身高体重，我帮你核对。'],['限时提醒版','618活动进入最后阶段，之前收藏或问过的款式可以再确认一下库存。\n\n不确定尺码的直接发我信息，我帮你判断。']],
 intent:[['温和跟进版','前几天你看过的那款我又整理了一下上身效果和尺码建议。\n\n不急着下单，想对比颜色或版型可以直接问我。'],['决策辅助版','你之前关注的款式，主要差别在版型和使用场景。\n\n把平时尺码和偏好告诉我，我可以帮你缩小选择范围。'],['库存提醒版','之前咨询的款式目前还有库存。\n\n如果还在考虑，我可以把细节图和尺码建议再发你参考。']],
 old:[['老客关怀版','最近上了一些适合日常通勤的新款，想到你之前比较喜欢简洁好搭的版型。\n\n有空可以看看，不合适也没关系。'],['换季提醒版','最近天气变化比较快，店里补了一些适合换季叠穿的款式。\n\n老朋友想看搭配或尺码可以直接找我。'],['轻互动版','最近在选下一批主推款，想听听老朋友的意见：更喜欢简洁通勤，还是轻松休闲一点的？']]
};
const seedEmployees=[{id:'e1',name:'陈东东大号',dept:'慧博科技研发'},{id:'e2',name:'王超',dept:'私域运营组'},{id:'e3',name:'张三',dept:'西安交付组'},{id:'e4',name:'李楠',dept:'私域运营组'}];
const tagGroups=[{name:'客户价值',tags:['高价值客户','高意向客户','普通客户']},{name:'购买行为',tags:['已购买','收藏加购未购买','180天未购买']},{name:'会员状态',tags:['店铺会员','未入会','老会员']}];
const folderSeed=[{id:'f_unc',name:'未分类',parentId:null,open:true},{id:'f_test',name:'测试1',parentId:null,open:true},{id:'f_test_1',name:'二十三世',parentId:'f_test',open:true},{id:'f_gd',name:'广东',parentId:null,open:true},{id:'f_gd_1',name:'东东',parentId:'f_gd',open:true},{id:'f_new',name:'新品图',parentId:null,open:true},{id:'f_act',name:'活动图',parentId:null,open:true}];
const svgData=(label,i=0)=>`data:image/svg+xml;charset=UTF-8,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="700" height="700"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${['#e9efff','#f5e8ff','#e8f8f2','#fff0e7'][i%4]}"/><stop offset="1" stop-color="${['#9db7f5','#d3a8ef','#9fd8c1','#efb398'][i%4]}"/></linearGradient></defs><rect width="700" height="700" rx="36" fill="url(#g)"/><circle cx="530" cy="145" r="80" fill="rgba(255,255,255,.55)"/><rect x="155" y="130" width="390" height="430" rx="28" fill="rgba(255,255,255,.72)"/><path d="M270 455 L330 240 Q350 190 380 240 L440 455 Q450 500 405 515 L305 515 Q260 500 270 455" fill="#748fc9"/><text x="350" y="620" text-anchor="middle" font-size="34" font-family="Arial" fill="#334155">${label}</text></svg>`)}`;
const seedMaterials=[{id:'mat1',title:'法式连衣裙正面',folderId:'f_new',src:svgData('新品图 1',0)},{id:'mat2',title:'法式连衣裙细节',folderId:'f_new',src:svgData('新品图 2',1)},{id:'mat3',title:'618活动海报',folderId:'f_act',src:svgData('活动图',3)},{id:'mat4',title:'广东门店素材',folderId:'f_gd_1',src:svgData('广东·东东',2)}];
function newMoment(index=0){return{id:uid('m'),createdOrder:Date.now()+index,name:`规则${index+1}`,copySource:'ai',template:'new',copyGoal:'',candidates:[],finalCopy:'',originalCopy:'',imageSource:'ai',noImage:false,aiSlots:[{id:uid('slot'),prompt:'',refs:[],result:null}],existingImages:[],material:null,sendMode:'now',customTime:'',validityMode:'today',validityTime:''}}
const defaultState=()=>({taskName:'',employees:[seedEmployees[0]],audienceSource:'tag',audienceMode:'all',tags:[],estimated:3680,smartQuery:'',smartAudience:null,smartApplied:false,moments:[newMoment(0)],activeMomentId:null,folders:folderSeed,materials:seedMaterials});
let state=defaultState();state.activeMomentId=state.moments[0].id;
let tempEmployees=new Set(),tempTags=new Set(),uploadQueue=[],materialSelection=new Set(),materialFolder='all',previewMomentId=null,dragPreviewId=null,deleteId=null,materialTarget='existing';
function toast(msg){const el=$('toast');if(!el)return;el.textContent=msg;el.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>el.classList.remove('show'),1800)}
function openModal(id){$(id)?.classList.add('show')}
function closeModal(id){$(id)?.classList.remove('show')}
function saveDraft(immediate=false){$('draftStatus').textContent='保存中...';clearTimeout(saveDraft.t);saveDraft.t=setTimeout(()=>{try{storage.setItem(DRAFT_KEY,JSON.stringify(state))}catch{}$('draftStatus').textContent='已自动保存'},immediate?0:180)}
function loadDraft(){try{const raw=storage.getItem(DRAFT_KEY);if(raw){const parsed=JSON.parse(raw);if(parsed&&Array.isArray(parsed.moments)&&parsed.moments.length){state={...defaultState(),...parsed};state.activeMomentId=state.activeMomentId&&state.moments.some(m=>m.id===state.activeMomentId)?state.activeMomentId:state.moments[0].id}}}catch{}}
function activeMoment(){return state.moments.find(m=>m.id===state.activeMomentId)||state.moments[0]}
function momentById(id){return state.moments.find(m=>m.id===id)}
function materialType(m){if(m.noImage)return'无素材';if(m.material)return({link:'链接',video:'视频',radar:'素材雷达'}[m.material.type]||'素材');if(m.imageSource==='ai')return m.aiSlots.some(s=>s.result)?'图片':'未设置';return m.existingImages.length?'图片':'未设置'}
function validityText(m){return m.validityMode==='custom'?(m.validityTime?formatDate(m.validityTime):'未设置'):'当天'}
function scheduleText(m){return m.sendMode==='now'?'立即发送':(m.customTime?formatDate(m.customTime):'未设置')}
function statusOf(m){const missing=[];if(!m.name.trim())missing.push('名称');if(!m.finalCopy.trim())missing.push('文案');if(!m.noImage&&!m.material&&!m.aiSlots.some(s=>s.result)&&!m.existingImages.length)missing.push('素材');if(m.sendMode==='custom'&&!m.customTime)missing.push('发布时间');if(m.validityMode==='custom'&&!m.validityTime)missing.push('有效期');return{ok:!missing.length,label:missing.length?'待完善':'已完成',issue:missing.length?`待完善：${missing.join('、')}`:''}}
function orderedMoments(){return [...state.moments].sort((a,b)=>{const ar=a.sendMode==='now'?0:a.customTime?1:2,br=b.sendMode==='now'?0:b.customTime?1:2;if(ar!==br)return ar-br;if(ar===1){const d=new Date(a.customTime)-new Date(b.customTime);if(d)return d}return a.createdOrder-b.createdOrder})}
function summaryCopy(m){const s=m.finalCopy.trim();return s?s.length>60?s.slice(0,60)+'…':s:'尚未确定文案'}
function insertBasicInfo(){if($('basicInfoPanel'))return;const panel=document.createElement('div');panel.id='basicInfoPanel';panel.className='form-section basic-info-section';panel.innerHTML=`<div class="section-title">基本信息</div><div class="surface basic-info-card"><div class="basic-info-row"><div class="form-field-label required">任务名称</div><div class="title-input-wrap"><input id="taskName" class="input" maxlength="20" placeholder="请输入任务名称"><span id="taskNameCount">0/20</span></div></div></div>`;$('workspace').insertBefore(panel,$('step1Panel'));$('taskName').oninput=e=>{state.taskName=e.target.value.slice(0,20);$('taskNameCount').textContent=`${state.taskName.length}/20`;saveDraft()}}
function prepareDom(){document.title='发布朋友圈 · AI朋友圈 v4.8.3';insertBasicInfo();q('#step2Panel>.section-title').textContent='第二步：设置朋友圈内容';q('.image-step-head .moment-subsection-title').textContent='朋友圈素材';qa('[data-image-source]').forEach(t=>{if(t.dataset.imageSource==='existing')t.textContent='使用已有素材'});const existingLabel=q('#existingImageSource .label');if(existingLabel)existingLabel.textContent='已有素材';const add=$('addMomentBtn');add.innerHTML='<span class="plus">＋</span><span><b>新建一条朋友圈</b></span>';q('.moment-schedule-subsection').innerHTML=`<div class="schedule-config-grid"><div class="schedule-config-block"><div class="moment-subsection-title">发布时间</div><div class="moment-time-options"><label class="send-mode-option compact"><div class="send-mode-main"><input type="radio" name="sendMode" value="now"><div><b>立即发送</b><span>任务创建后立即通知员工</span></div></div></label><label class="send-mode-option compact"><div class="send-mode-main"><input type="radio" name="sendMode" value="custom"><div><b>定时发送</b><span>按指定时间通知员工</span></div></div><input id="customSendTime" type="datetime-local" class="input custom-time-input"></label></div><div id="momentTimeNotice" class="tiny moment-time-notice"></div></div><div class="schedule-config-block"><div class="moment-subsection-title">发布有效期</div><div class="validity-options"><label class="validity-option"><input type="radio" name="validityMode" value="today"><span><b>当天</b><small>当天内员工可执行发表</small></span></label><label class="validity-option"><input type="radio" name="validityMode" value="custom"><span><b>自定义</b><small>指定截止时间</small></span></label></div><input id="customValidityTime" type="datetime-local" class="input custom-validity-input hidden"></div></div><div class="schedule-action-row"><button id="saveCollapseMomentBtn" class="btn primary save-collapse-btn" type="button">保存并收起</button></div>`;$('createTaskBtn').textContent='创建任务';$('step4Panel').setAttribute('aria-hidden','true');createDynamicModals();bindStaticEvents()}
function createDynamicModals(){if(!$('momentPreviewModal'))document.body.insertAdjacentHTML('beforeend',`<div id="momentPreviewModal" class="modal-mask preview-popover-mask"><div class="quick-preview-dialog"><button class="preview-popover-close" type="button">×</button><div class="phone quick-preview-phone"><div class="phone-status"><span>9:41</span><span>▮▮ ◔</span></div><div class="phone-nav"><span>‹</span><b>朋友圈</b><span>•••</span></div><div class="moment"><div class="user-line"><div class="avatar"></div><div class="moment-main"><div id="quickPhoneUserName" class="user-name">发布员工</div><div id="quickPhoneCopy" class="moment-copy"></div><div id="quickPhoneMedia" class="moment-images"></div><div class="moment-meta"><span id="quickPhoneTime">刚刚</span><span class="more-box">••</span></div></div></div></div></div></div></div>`);if(!$('materialTypeModal'))document.body.insertAdjacentHTML('beforeend',`<div id="materialTypeModal" class="modal-mask"><div class="modal small"><div class="modal-hd"><div class="modal-title">添加素材</div><button class="close-btn" data-close="materialTypeModal">×</button></div><div class="modal-bd"><div class="material-type-grid"><button class="material-type-card" data-material-type="image"><span class="material-type-icon">▧</span><b>图片</b><small>上传本地图片或从素材中心导入</small></button><button class="material-type-card" data-material-type="link"><span class="material-type-icon">↗</span><b>链接</b><small>添加网页或商品链接</small></button><button class="material-type-card" data-material-type="video"><span class="material-type-icon">▶</span><b>视频</b><small>添加一个视频素材</small></button><button class="material-type-card" data-material-type="radar"><span class="material-type-icon">◎</span><b>素材雷达</b><small>选择素材雷达内容</small></button></div></div></div></div>`);if(!$('simpleMaterialModal'))document.body.insertAdjacentHTML('beforeend',`<div id="simpleMaterialModal" class="modal-mask"><div class="modal small"><div class="modal-hd"><div id="simpleMaterialTitle" class="modal-title">添加素材</div><button class="close-btn" data-close="simpleMaterialModal">×</button></div><div class="modal-bd"><label style="display:grid;gap:8px"><span id="simpleMaterialLabel" class="label">素材名称</span><input id="simpleMaterialInput" class="input" maxlength="120" placeholder="请输入"></label></div><div class="modal-ft"><button class="btn" data-close="simpleMaterialModal">取消</button><button id="confirmSimpleMaterial" class="btn primary">确定</button></div></div></div>`);const modal=$('taskConfirmModal');q('.modal-title',modal).textContent='确认创建朋友圈任务';q('.modal-bd',modal).innerHTML=`<div class="confirm-summary"><div class="confirm-row"><span class="k">任务名称</span><span id="confirmTaskName" class="v">-</span></div><div class="confirm-row"><span class="k">发布员工</span><span id="confirmEmployees" class="v">-</span></div><div class="confirm-row"><span class="k">可见客户</span><span id="confirmAudience" class="v">-</span></div><div class="confirm-row"><span class="k">朋友圈条数</span><span id="confirmMomentCount" class="v">-</span></div></div><div id="confirmScheduleList" class="confirm-schedule-list"></div>`;$('confirmCreateTaskBtn').textContent='确认创建'}
function bindStaticEvents(){qa('[data-close]').forEach(b=>b.onclick=()=>closeModal(b.dataset.close));$('openAiBtn').onclick=()=>{$('listPage').classList.remove('active');$('aiPage').classList.add('active');renderAll()};$('backListBtn').onclick=()=>{$('aiPage').classList.remove('active');$('listPage').classList.add('active')};$('cancelCreateBtn').onclick=$('backListBtn').onclick;$('chooseEmployeesBtn').onclick=openEmployees;$('confirmEmployeesBtn').onclick=confirmEmployees;$('clearEmployeesBtn').onclick=()=>{tempEmployees.clear();renderEmployeeModal()};$('audienceAll').onchange=updateAudienceFromForm;$('audiencePartial').onchange=updateAudienceFromForm;$('chooseTagsBtn').onclick=openTags;$('confirmTagsBtn').onclick=confirmTags;$('clearTagsBtn').onclick=()=>{tempTags.clear();renderTagModal()};$('estimateBtn').onclick=estimateAudience;qa('[data-audience-source]').forEach(b=>b.onclick=()=>switchAudience(b.dataset.audienceSource));qa('[data-smart-suggest]').forEach(b=>b.onclick=()=>{$('smartAudienceQuery').value=b.dataset.smartSuggest});$('smartCreateBtn').onclick=generateSmartAudience;$('regenerateSmartAudienceBtn').onclick=generateSmartAudience;$('adjustSmartAudienceBtn').onclick=()=>{$('smartAudienceReport').classList.add('hidden');$('smartAudienceCreate').classList.remove('hidden')};$('applySmartAudienceBtn').onclick=applySmartAudience;qa('[data-template]').forEach(b=>b.onclick=()=>{activeMoment().template=b.dataset.template;qa('[data-template]').forEach(x=>x.classList.toggle('active',x===b));saveDraft()});$('copyGoal').oninput=e=>{activeMoment().copyGoal=e.target.value;saveDraft()};$('generateCopyBtn').onclick=generateCopy;$('applyManualCopyBtn').onclick=()=>applyCopy($('manualSourceCopy').value);$('manualSourceCopy').oninput=e=>{activeMoment().manualCopy=e.target.value;saveDraft()};$('finalCopy').oninput=e=>{activeMoment().finalCopy=e.target.value.slice(0,1000);$('copyCharCount').textContent=`${activeMoment().finalCopy.length} / 1000`;updateActiveCard();saveDraft()};$('restoreCopyBtn').onclick=()=>{const m=activeMoment();if(m.originalCopy){m.finalCopy=m.originalCopy;loadEditor(m);saveDraft()}};qa('[data-copy-source]').forEach(t=>t.onclick=()=>switchCopySource(t.dataset.copySource));qa('[data-image-source]').forEach(t=>t.onclick=()=>switchImageSource(t.dataset.imageSource));$('noImageCheck').onchange=e=>{activeMoment().noImage=e.target.checked;renderImages();updateActiveCard();saveDraft()};$('addSlotBtn').onclick=addAiSlot;$('addMomentBtn').onclick=addMoment;$('saveCollapseMomentBtn').onclick=saveAndCollapse;$('createTaskBtn').onclick=openTaskConfirm;$('confirmCreateTaskBtn').onclick=()=>{closeModal('taskConfirmModal');toast('朋友圈任务已创建（演示）')};$('confirmDeleteMomentBtn').onclick=deleteMoment;$('chooseLocalSource').onclick=()=>{closeModal('imageSourceModal');$('realImageInput').click()};$('chooseMaterialSource').onclick=()=>{closeModal('imageSourceModal');openMaterialCenter()};$('realImageInput').onchange=handleFiles;$('confirmLocalUploadBtn').onclick=confirmLocalUpload;$('confirmMaterialPickBtn').onclick=confirmMaterialPick;$('createRootFolderBtn').onclick=()=>createFolder(null);$('createChildFolderBtn').onclick=()=>createFolder(materialFolder==='all'?null:materialFolder);$('momentPreviewModal').onclick=e=>{if(e.target===$('momentPreviewModal'))closeModal('momentPreviewModal')};q('.preview-popover-close').onclick=()=>closeModal('momentPreviewModal');qa('[data-material-type]').forEach(b=>b.onclick=()=>chooseMaterialType(b.dataset.materialType));$('confirmSimpleMaterial').onclick=confirmSimpleMaterial;document.addEventListener('keydown',e=>{if(e.key==='Escape')qa('.modal-mask.show').forEach(m=>m.classList.remove('show'))})}
function renderAll(){renderBasic();renderScope();renderMoments();renderEditor();}
function renderBasic(){$('taskName').value=state.taskName;$('taskNameCount').textContent=`${state.taskName.length}/20`}
function renderScope(){$('employeeResult').innerHTML=state.employees.length?state.employees.map(e=>`<span class="tag-chip">${escapeHtml(e.name)}</span>`).join(''):'<span class="tiny">尚未选择员工</span>';switchAudience(state.audienceSource,false);if(state.audienceSource==='tag'){$('audienceAll').checked=state.audienceMode==='all';$('audiencePartial').checked=state.audienceMode==='partial';$('tagRow').classList.toggle('hidden',state.audienceMode!=='partial');renderSelectedTags();renderEstimate()}else renderSmartReport()}
function switchAudience(type,save=true){state.audienceSource=type;qa('[data-audience-source]').forEach(b=>b.classList.toggle('active',b.dataset.audienceSource===type));$('aiAudiencePanel').classList.toggle('hidden',type!=='ai');$('tagAudiencePanel').classList.toggle('hidden',type!=='tag');if(save)saveDraft()}
function openEmployees(){tempEmployees=new Set(state.employees.map(e=>e.id));renderEmployeeModal();openModal('employeeModal')}
function renderEmployeeModal(){$('employeeList').innerHTML=seedEmployees.map(e=>`<label class="person-row"><span><b>${escapeHtml(e.name)}</b><span class="tiny" style="display:block">${escapeHtml(e.dept)}</span></span><input type="checkbox" data-emp-id="${e.id}" ${tempEmployees.has(e.id)?'checked':''}></label>`).join('');qa('[data-emp-id]').forEach(c=>c.onchange=()=>{c.checked?tempEmployees.add(c.dataset.empId):tempEmployees.delete(c.dataset.empId);renderEmployeeModal()});$('selectedEmployeeList').innerHTML=seedEmployees.filter(e=>tempEmployees.has(e.id)).map(e=>`<div class="selected-person">${escapeHtml(e.name)}</div>`).join('')||'<span class="tiny">尚未选择</span>';$('employeeCount').textContent=tempEmployees.size}
function confirmEmployees(){state.employees=seedEmployees.filter(e=>tempEmployees.has(e.id));closeModal('employeeModal');renderScope();saveDraft()}
function updateAudienceFromForm(){state.audienceMode=$('audiencePartial').checked?'partial':'all';$('tagRow').classList.toggle('hidden',state.audienceMode!=='partial');state.estimated=null;renderEstimate();saveDraft()}
function openTags(){tempTags=new Set(state.tags);renderTagModal();openModal('tagModal')}
function renderTagModal(){const term=$('tagSearch').value.trim();$('tagCategoryList').innerHTML=tagGroups.map(g=>`<div class="tag-category"><div class="category-head"><b>${g.name}</b></div><div class="category-tags">${g.tags.filter(t=>!term||t.includes(term)).map(t=>`<button class="select-tag ${tempTags.has(t)?'selected':''}" data-tag-name="${t}">${t}</button>`).join('')}</div></div>`).join('');qa('[data-tag-name]').forEach(b=>b.onclick=()=>{tempTags.has(b.dataset.tagName)?tempTags.delete(b.dataset.tagName):tempTags.add(b.dataset.tagName);renderTagModal()});$('selectedTagCount').textContent=tempTags.size;$('selectedTagBody').innerHTML=[...tempTags].map(t=>`<span class="tag-chip">${escapeHtml(t)}</span>`).join('')||'<div class="empty-state">尚未选择标签</div>'}
function confirmTags(){state.tags=[...tempTags];state.estimated=null;closeModal('tagModal');renderSelectedTags();renderEstimate();saveDraft()}
function renderSelectedTags(){$('selectedTagResult').innerHTML=state.tags.length?state.tags.map(t=>`<span class="tag-chip">${escapeHtml(t)}</span>`).join(''):'<span class="tiny">尚未选择标签</span>'}
function estimateAudience(){if(state.audienceMode==='partial'&&!state.tags.length)return toast('请先选择标签');state.estimated=state.audienceMode==='all'?3680:Math.max(180,3680-state.tags.length*720);renderEstimate();saveDraft()}
function renderEstimate(){const el=$('estimateResult');if(state.estimated==null){el.classList.add('hidden');return}el.classList.remove('hidden');el.innerHTML=`预计可触达 <b style="color:var(--brand)">${Number(state.estimated).toLocaleString()}</b> 人，实际人数以任务创建时为准。`}
function generateSmartAudience(){const query=$('smartAudienceQuery').value.trim();if(!query)return toast('请先描述目标人群');state.smartQuery=query;state.smartAudience={name:query.length>16?query.slice(0,16)+'…':query,estimated:1260,rules:['近90天有访问','未完成购买','企业微信好友'],insight:'这类客户已有一定兴趣，但尚未完成转化，适合用真实上身效果和轻量权益降低决策门槛。'};state.smartApplied=false;renderSmartReport();saveDraft()}
function renderSmartReport(){if(!state.smartAudience){$('smartAudienceCreate').classList.remove('hidden');$('smartAudienceReport').classList.add('hidden');$('smartAudienceQuery').value=state.smartQuery||'';return}$('smartAudienceCreate').classList.add('hidden');$('smartAudienceReport').classList.remove('hidden');$('smartAudienceName').textContent=state.smartAudience.name;$('smartEstimatedSize').textContent=state.smartAudience.estimated.toLocaleString();$('smartAudienceInsight').textContent=state.smartAudience.insight;$('smartRuleChips').innerHTML=state.smartAudience.rules.map(r=>`<span class="smart-rule-chip">${escapeHtml(r)}</span>`).join('');$('smartAppliedBadge').classList.toggle('hidden',!state.smartApplied);$('applySmartAudienceBtn').textContent=state.smartApplied?'已使用':'使用该人群'}
function applySmartAudience(){if(!state.smartAudience)return;state.smartApplied=true;state.estimated=state.smartAudience.estimated;renderSmartReport();toast('已使用该人群');saveDraft()}
function renderMoments(){const list=orderedMoments();$('momentList').innerHTML=list.map((m,i)=>momentCard(m,i)).join('');qa('[data-edit-moment]').forEach(b=>b.onclick=()=>{state.activeMomentId=b.dataset.editMoment;renderMoments();renderEditor();scrollToCard(b.dataset.editMoment)});qa('[data-preview-moment]').forEach(b=>b.onclick=e=>openPreview(b.dataset.previewMoment,e.currentTarget));qa('[data-delete-moment]').forEach(b=>b.onclick=()=>requestDelete(b.dataset.deleteMoment));qa('[data-rule-name]').forEach(inp=>{inp.oninput=()=>{const m=momentById(inp.dataset.ruleName);m.name=inp.value.slice(0,20);updateActiveCard();saveDraft()};inp.onblur=()=>{const m=momentById(inp.dataset.ruleName);if(!m.name.trim()){const i=state.moments.indexOf(m);m.name=`规则${i+1}`;renderMoments();renderEditor()}}});const active=activeMoment(),host=q(`[data-editor-host="${active.id}"]`);if(host)host.appendChild($('momentEditor'))}
function momentCard(m,i){const st=statusOf(m),active=m.id===state.activeMomentId;return`<div class="moment-module ${active?'active':''}" data-moment-card="${m.id}"><div class="moment-module-head"><div class="moment-module-ident"><div class="moment-module-index">第 ${i+1} 条</div><div class="rule-name-wrap"><input class="rule-name-input" data-rule-name="${m.id}" maxlength="20" value="${escapeHtml(m.name)}" aria-label="规则名称"><span class="rule-name-count">${m.name.length}/20</span></div><span class="badge ${st.ok?'green':'orange'}" data-module-status="${m.id}">${st.label}</span></div><div class="moment-module-actions"><button class="btn small" data-preview-moment="${m.id}">预览</button>${active?'<span class="editing-label">编辑中</span>':`<button class="btn small" data-edit-moment="${m.id}">编辑</button>`}<button class="btn small danger" data-delete-moment="${m.id}" ${state.moments.length===1?'disabled':''}>删除</button></div></div><div class="moment-module-summary ${active?'hidden':''}"><div><span class="summary-key">发布时间</span><b data-summary-time="${m.id}">${scheduleText(m)}</b></div><div class="summary-validity"><span class="summary-key">发布有效期</span><b data-summary-validity="${m.id}">${validityText(m)}</b></div><div class="summary-copy"><span class="summary-key">文案</span><span data-summary-copy="${m.id}" title="${escapeHtml(m.finalCopy)}">${escapeHtml(summaryCopy(m))}</span></div><div class="summary-material"><span class="summary-key">素材</span><b data-summary-material="${m.id}">${materialType(m)}</b></div>${st.issue?`<div class="module-issue">${st.issue}</div>`:''}</div><div class="moment-module-editor-host" data-editor-host="${m.id}"></div></div>`}
function scrollToCard(id){q(`[data-moment-card="${id}"]`)?.scrollIntoView({behavior:'smooth',block:'start'})}
function renderEditor(){const m=activeMoment();if(!m)return;$('momentEditor').classList.remove('hidden');loadEditor(m);renderCopyCandidates();renderImages();renderSchedule()}
function loadEditor(m){qa('[data-template]').forEach(b=>b.classList.toggle('active',b.dataset.template===m.template));$('copyGoal').value=m.copyGoal||'';$('manualSourceCopy').value=m.manualCopy||'';$('finalCopy').value=m.finalCopy;$('copyCharCount').textContent=`${m.finalCopy.length} / 1000`;$('restoreCopyBtn').disabled=!m.originalCopy;switchCopySource(m.copySource,false);switchImageSource(m.imageSource,false);$('noImageCheck').checked=m.noImage}
function switchCopySource(src,save=true){const m=activeMoment();m.copySource=src;qa('[data-copy-source]').forEach(t=>t.classList.toggle('active',t.dataset.copySource===src));$('copyAiSource').classList.toggle('hidden',src!=='ai');$('copyManualSource').classList.toggle('hidden',src!=='manual');if(save)saveDraft()}
function generateCopy(){const m=activeMoment(),count=Math.max(1,Math.min(6,Number($('copyCountSelect').value)||1)),pool=templates[m.template]||templates.new,goal=m.copyGoal.trim();m.candidates=Array.from({length:count},(_,i)=>{const item=pool[i%pool.length];return{summary:item[0],text:goal?`${item[1]}\n\n${goal}`:item[1]}});renderCopyCandidates();saveDraft()}
function renderCopyCandidates(){const m=activeMoment();$('copyList').innerHTML=m.candidates.length?m.candidates.map((c,i)=>`<div class="copy-option ${m.originalCopy===c.text?'active':''}" data-copy-index="${i}"><div class="copy-option-title"><span>${escapeHtml(c.summary)}</span><span class="badge blue">候选${i+1}</span></div><div class="copy-option-text">${escapeHtml(c.text)}</div></div>`).join(''):'<div class="tiny empty-copy-state">还没有生成候选文案</div>';qa('[data-copy-index]').forEach(c=>c.onclick=()=>applyCopy(m.candidates[Number(c.dataset.copyIndex)].text))}
function applyCopy(text){const m=activeMoment();if(!text.trim())return toast('文案不能为空');m.originalCopy=text.trim();m.finalCopy=text.trim().slice(0,1000);loadEditor(m);renderCopyCandidates();updateActiveCard();saveDraft()}
function switchImageSource(src,save=true){const m=activeMoment();m.imageSource=src;qa('[data-image-source]').forEach(t=>t.classList.toggle('active',t.dataset.imageSource===src));$('aiImageSource').classList.toggle('hidden',src!=='ai');$('existingImageSource').classList.toggle('hidden',src!=='existing');renderImages();if(save)saveDraft()}
function renderImages(){const m=activeMoment();$('imageContent').classList.toggle('hidden',m.noImage);if(m.noImage)return;if(m.imageSource==='ai')renderAiSlots();else renderExisting()}
function renderAiSlots(){$('slotList').innerHTML=activeMoment().aiSlots.map((s,i)=>`<div class="ai-slot-v483"><div class="ai-slot-head-v483"><b>图片 ${i+1}</b><button class="btn small danger" data-remove-slot="${s.id}" ${activeMoment().aiSlots.length===1?'disabled':''}>删除</button></div><div class="ai-slot-body-v483"><div><div class="slot-label">参考图片（可选）</div><div class="ref-grid-v483">${s.refs.map((r,j)=>`<div class="ref-card-v483"><img src="${r.src}" alt="参考图"><button class="ref-remove-v483" data-remove-ref="${s.id}:${j}">×</button></div>`).join('')}<label class="ref-add-v483">＋ 添加<input type="file" accept="image/*" multiple hidden data-ref-upload="${s.id}"></label></div><div class="tiny">最多6张参考图</div></div><div><div class="slot-label">图片要求</div><textarea class="textarea" rows="7" data-slot-prompt="${s.id}" placeholder="描述画面主体、场景和风格">${escapeHtml(s.prompt)}</textarea><div class="ai-actions-v483"><button class="btn primary" data-generate-image="${s.id}">${s.result?'重新生成图片':'生成图片'}</button></div></div><div><div class="slot-label">结果预览</div><div class="ai-result-v483">${s.result?`<img src="${s.result.src}" alt="生成结果">`:'等待生成'}</div><div class="ai-actions-v483">${s.result?`<button class="btn small" data-save-generated="${s.id}">导入素材中心</button>`:''}</div></div></div></div>`).join('');qa('[data-slot-prompt]').forEach(t=>t.oninput=()=>{const s=activeMoment().aiSlots.find(x=>x.id===t.dataset.slotPrompt);s.prompt=t.value;saveDraft()});qa('[data-generate-image]').forEach(b=>b.onclick=()=>generateImage(b.dataset.generateImage));qa('[data-remove-slot]').forEach(b=>b.onclick=()=>{const m=activeMoment();m.aiSlots=m.aiSlots.filter(s=>s.id!==b.dataset.removeSlot);renderAiSlots();updateActiveCard();saveDraft()});qa('[data-ref-upload]').forEach(inp=>inp.onchange=e=>addReferences(inp.dataset.refUpload,e.target.files));qa('[data-remove-ref]').forEach(b=>b.onclick=()=>{const[id,index]=b.dataset.removeRef.split(':');const s=activeMoment().aiSlots.find(x=>x.id===id);s.refs.splice(Number(index),1);renderAiSlots();saveDraft()});qa('[data-save-generated]').forEach(b=>b.onclick=()=>{const s=activeMoment().aiSlots.find(x=>x.id===b.dataset.saveGenerated);if(s?.result){state.materials.push({id:uid('mat'),title:`AI生成图${state.materials.length+1}`,folderId:'f_unc',src:s.result.src});toast('已保存到素材中心')}})}
function addAiSlot(){const m=activeMoment();if(m.aiSlots.length>=9)return toast('每条朋友圈最多9张图片');m.aiSlots.push({id:uid('slot'),prompt:'',refs:[],result:null});renderAiSlots();saveDraft()}
function addReferences(slotId,files){const slot=activeMoment().aiSlots.find(s=>s.id===slotId);[...files].slice(0,6-slot.refs.length).forEach(file=>{const reader=new FileReader();reader.onload=()=>{slot.refs.push({name:file.name,src:reader.result});renderAiSlots();saveDraft()};reader.readAsDataURL(file)})}
function generateImage(slotId){const m=activeMoment(),slot=m.aiSlots.find(s=>s.id===slotId),i=m.aiSlots.indexOf(slot);slot.result={id:uid('img'),src:svgData(slot.prompt.trim()||`AI配图 ${i+1}`,i)};renderAiSlots();updateActiveCard();saveDraft()}
function renderExisting(){const m=activeMoment(),grid=$('existingImageGrid');if(m.material){const icons={link:'↗',video:'▶',radar:'◎'};grid.innerHTML=`<div class="existing-material-card"><div class="existing-material-main"><div class="existing-material-icon">${icons[m.material.type]||'◇'}</div><div class="existing-material-info"><b>${escapeHtml(m.material.title)}</b><span class="tiny">${materialType(m)}</span></div></div><div class="existing-material-actions"><button class="btn small" data-change-material>更换</button><button class="btn small danger" data-remove-material>删除</button></div></div>`;q('[data-change-material]').onclick=openMaterialType;q('[data-remove-material]').onclick=()=>{m.material=null;renderExisting();updateActiveCard();saveDraft()};return}grid.innerHTML=m.existingImages.map((img,i)=>`<div class="existing-image-card"><div class="existing-image-title">${escapeHtml(img.title||`图片${i+1}`)}</div><div class="slot-result"><img src="${img.src}" alt="已有图片"></div><div class="existing-card-actions"><button class="btn small danger" data-remove-existing="${img.id}">删除</button></div></div>`).join('')+`<button class="existing-add-tile" id="existingAddTile" type="button"><span class="plus">＋</span><b>添加素材</b><span class="tiny">支持图片、链接、视频、素材雷达</span></button>`;$('existingAddTile').onclick=openMaterialType;qa('[data-remove-existing]').forEach(b=>b.onclick=()=>{m.existingImages=m.existingImages.filter(x=>x.id!==b.dataset.removeExisting);renderExisting();updateActiveCard();saveDraft()})}
function openMaterialType(){openModal('materialTypeModal')}
function chooseMaterialType(type){closeModal('materialTypeModal');if(type==='image'){materialTarget='existing';openModal('imageSourceModal');return}simpleMaterialType=type;$('simpleMaterialTitle').textContent={link:'添加链接',video:'添加视频',radar:'添加素材雷达'}[type];$('simpleMaterialLabel').textContent=type==='link'?'链接地址':'素材名称';$('simpleMaterialInput').value='';$('simpleMaterialInput').placeholder=type==='link'?'请输入 https:// 开头的链接':'请输入素材名称';openModal('simpleMaterialModal')}
let simpleMaterialType='link';
function confirmSimpleMaterial(){const value=$('simpleMaterialInput').value.trim();if(!value)return toast('请填写素材信息');const m=activeMoment();m.existingImages=[];m.material={type:simpleMaterialType,title:value};m.imageSource='existing';closeModal('simpleMaterialModal');renderImages();updateActiveCard();saveDraft()}
function handleFiles(e){const files=[...e.target.files];if(!files.length)return;uploadQueue=[];let left=files.length;files.forEach(file=>{const reader=new FileReader();reader.onload=()=>{uploadQueue.push({id:uid('up'),title:file.name.replace(/\.[^.]+$/,'' ).slice(0,20),src:reader.result});if(--left===0)renderUploadQueue()};reader.readAsDataURL(file)});e.target.value=''}
function renderUploadQueue(){$('localUploadList').innerHTML=uploadQueue.map((x,i)=>`<div class="local-upload-item"><img class="local-upload-thumb" src="${x.src}" alt="上传预览"><div class="local-upload-fields"><div class="upload-title-row"><input class="input" maxlength="20" data-upload-title="${i}" value="${escapeHtml(x.title)}"><span class="upload-title-count">${x.title.length}/20</span></div></div></div>`).join('');qa('[data-upload-title]').forEach(inp=>inp.oninput=()=>{uploadQueue[Number(inp.dataset.uploadTitle)].title=inp.value.slice(0,20);inp.nextElementSibling.textContent=`${inp.value.length}/20`});openModal('localUploadModal')}
function confirmLocalUpload(){const m=activeMoment(),remaining=9-m.existingImages.length;m.material=null;m.existingImages.push(...uploadQueue.slice(0,remaining));m.imageSource='existing';uploadQueue=[];closeModal('localUploadModal');renderImages();updateActiveCard();saveDraft()}
function folderById(id){return state.folders.find(f=>f.id===id)}
function folderPath(id){const parts=[];let f=folderById(id);while(f){parts.unshift(f.name);f=folderById(f.parentId)}return parts.join(' / ')}
function renderFolderTree(){const roots=state.folders.filter(f=>!f.parentId);const rows=[];const walk=(f,depth)=>{const kids=state.folders.filter(x=>x.parentId===f.id);rows.push(`<div class="folder-tree-row ${materialFolder===f.id?'active':''}" data-folder-id="${f.id}" style="padding-left:${8+depth*18}px"><button class="folder-tree-toggle ${kids.length?'':'placeholder'}" data-toggle-folder="${f.id}">${kids.length?(f.open?'⌄':'›'):''}</button><span class="folder-tree-icon">▰</span><span class="folder-tree-name">${escapeHtml(f.name)}</span><span class="folder-tree-count">${state.materials.filter(m=>m.folderId===f.id).length}</span></div>`);if(f.open)kids.forEach(k=>walk(k,depth+1))};roots.forEach(f=>walk(f,0));$('materialFolderTree').innerHTML=`<div class="folder-tree-all"><div class="folder-tree-row ${materialFolder==='all'?'active':''}" data-folder-id="all"><span class="folder-tree-toggle placeholder"></span><span class="folder-tree-icon">▦</span><span class="folder-tree-name">全部素材</span><span class="folder-tree-count">${state.materials.length}</span></div></div>${rows.join('')}`;qa('[data-folder-id]').forEach(r=>r.onclick=e=>{if(e.target.closest('[data-toggle-folder]'))return;materialFolder=r.dataset.folderId;materialSelection.clear();renderMaterialCenter()});qa('[data-toggle-folder]').forEach(b=>b.onclick=e=>{e.stopPropagation();const f=folderById(b.dataset.toggleFolder);f.open=!f.open;renderFolderTree()})}
function renderMaterialCenter(){renderFolderTree();const items=materialFolder==='all'?state.materials:state.materials.filter(m=>m.folderId===materialFolder);$('currentMaterialFolderName').textContent=materialFolder==='all'?'全部素材':folderById(materialFolder)?.name||'素材';$('currentMaterialFolderPath').textContent=materialFolder==='all'?'查看全部文件夹中的素材':folderPath(materialFolder);$('materialGrid').innerHTML=items.length?items.map(m=>`<div class="material-card ${materialSelection.has(m.id)?'active':''}" data-material-id="${m.id}"><img src="${m.src}" alt="素材"><div class="material-card-title">${escapeHtml(m.title)}</div><div class="material-card-meta">${escapeHtml(folderPath(m.folderId))}</div>${materialSelection.has(m.id)?'<span class="material-check">✓</span>':''}</div>`).join(''):'<div class="material-empty">当前文件夹暂无素材</div>';qa('[data-material-id]').forEach(c=>c.onclick=()=>{materialSelection.has(c.dataset.materialId)?materialSelection.delete(c.dataset.materialId):materialSelection.add(c.dataset.materialId);renderMaterialCenter()});$('materialPickHint').textContent=`已选 ${materialSelection.size} 张`}
function openMaterialCenter(){materialSelection.clear();materialFolder='all';renderMaterialCenter();openModal('materialCenterModal')}
function confirmMaterialPick(){const m=activeMoment(),chosen=state.materials.filter(x=>materialSelection.has(x.id)),remaining=9-m.existingImages.length;m.material=null;m.existingImages.push(...chosen.slice(0,remaining).map(x=>({id:uid('img'),title:x.title,src:x.src})));m.imageSource='existing';closeModal('materialCenterModal');renderImages();updateActiveCard();saveDraft()}
function createFolder(parentId){const name=prompt('请输入文件夹名称');if(!name?.trim())return;const clean=name.trim().slice(0,20);if(state.folders.some(f=>f.parentId===parentId&&f.name===clean))return toast('同级文件夹名称不能重复');const id=uid('f');state.folders.push({id,name:clean,parentId,open:true});if(parentId)folderById(parentId).open=true;materialFolder=id;renderMaterialCenter();saveDraft()}
function renderSchedule(){const m=activeMoment();qa('[name="sendMode"]').forEach(r=>r.checked=r.value===m.sendMode);$('customSendTime').value=m.customTime||'';$('customSendTime').disabled=m.sendMode!=='custom';qa('[name="validityMode"]').forEach(r=>r.checked=r.value===m.validityMode);$('customValidityTime').value=m.validityTime||'';$('customValidityTime').classList.toggle('hidden',m.validityMode!=='custom');qa('[name="sendMode"]').forEach(r=>r.onchange=()=>{m.sendMode=r.value;$('customSendTime').disabled=m.sendMode!=='custom';updateActiveCard();saveDraft()});$('customSendTime').onchange=e=>{m.customTime=e.target.value;updateActiveCard();saveDraft()};qa('[name="validityMode"]').forEach(r=>r.onchange=()=>{m.validityMode=r.value;$('customValidityTime').classList.toggle('hidden',m.validityMode!=='custom');updateActiveCard();saveDraft()});$('customValidityTime').onchange=e=>{m.validityTime=e.target.value;updateActiveCard();saveDraft()};$('saveCollapseMomentBtn').onclick=saveAndCollapse}
function updateActiveCard(){const m=activeMoment();if(!m)return;const st=statusOf(m),status=q(`[data-module-status="${m.id}"]`);if(status){status.className=`badge ${st.ok?'green':'orange'}`;status.textContent=st.label}const fields={time:scheduleText(m),validity:validityText(m),copy:summaryCopy(m),material:materialType(m)};Object.entries(fields).forEach(([k,v])=>{const el=q(`[data-summary-${k}="${m.id}"]`);if(el)el.textContent=v})}
function saveAndCollapse(){const m=activeMoment();saveDraft(true);const list=orderedMoments(),i=list.findIndex(x=>x.id===m.id),next=list[i+1]||list[i-1];state.activeMomentId=next&&next.id!==m.id?next.id:'';renderMoments();if(!state.activeMomentId){$('momentEditorParking').appendChild($('momentEditor'));$('momentEditor').classList.add('hidden')}toast('已保存并收起')}
function addMoment(){const m=newMoment(state.moments.length);state.moments.push(m);state.activeMomentId=m.id;renderMoments();renderEditor();scrollToCard(m.id);saveDraft()}
function requestDelete(id){if(state.moments.length===1)return;deleteId=id;$('deleteMomentName').textContent=momentById(id)?.name||'当前朋友圈';openModal('deleteMomentModal')}
function deleteMoment(){if(!deleteId)return;const index=state.moments.findIndex(m=>m.id===deleteId);state.moments.splice(index,1);if(state.activeMomentId===deleteId)state.activeMomentId=state.moments[Math.min(index,state.moments.length-1)].id;deleteId=null;closeModal('deleteMomentModal');renderMoments();renderEditor();saveDraft()}
function readyImages(m){return m.imageSource==='ai'?m.aiSlots.filter(s=>s.result).map(s=>({id:s.id,src:s.result.src})):m.existingImages.map(x=>({id:x.id,src:x.src}))}
function openPreview(id,button){const m=momentById(id);if(!m)return;previewMomentId=id;$('quickPhoneUserName').textContent=state.employees[0]?.name||'发布员工';$('quickPhoneCopy').textContent=m.finalCopy||'尚未确定文案';$('quickPhoneTime').textContent=m.sendMode==='now'?'刚刚':scheduleText(m);renderQuickMedia(m);openModal('momentPreviewModal');requestAnimationFrame(()=>positionPreview(button))}
function positionPreview(button){const d=q('.quick-preview-dialog'),r=button.getBoundingClientRect(),w=350,h=560;let left=r.left-w-10;if(left<12)left=Math.min(innerWidth-w-12,r.right+10);let top=Math.max(12,Math.min(r.top-14,innerHeight-h-12));d.style.left=`${left}px`;d.style.top=`${top}px`}
function renderQuickMedia(m){const el=$('quickPhoneMedia');if(m.material){const icons={link:'↗',video:'▶',radar:'◎'};el.className='moment-images';el.innerHTML=`<div class="phone-material-card"><div class="icon">${icons[m.material.type]||'◇'}</div><div class="info"><b>${escapeHtml(m.material.title)}</b><span>${materialType(m)}</span></div></div>`;return}const items=readyImages(m),sortable=items.length>1;el.className=`moment-images ${items.length===1?'count-1':items.length===2?'count-2':items.length===3?'count-3':items.length===4?'count-4':items.length>4?'count-many':''} ${sortable?'sortable':''}`;el.innerHTML=items.map((x,i)=>`<div class="moment-image-item" draggable="${sortable}" data-preview-image="${x.id}"><span class="drag-mark">⋮⋮</span><img class="moment-image" draggable="false" src="${x.src}" alt="朋友圈图片${i+1}"></div>`).join('');if(sortable)bindPreviewSort(m)}
function bindPreviewSort(m){qa('[data-preview-image]').forEach(el=>{el.ondragstart=e=>{dragPreviewId=el.dataset.previewImage;el.classList.add('dragging');e.dataTransfer.setData('text/plain',dragPreviewId)};el.ondragend=()=>qa('[data-preview-image]').forEach(x=>x.classList.remove('dragging','drag-over'));el.ondragover=e=>{e.preventDefault();if(el.dataset.previewImage!==dragPreviewId)el.classList.add('drag-over')};el.ondragleave=()=>el.classList.remove('drag-over');el.ondrop=e=>{e.preventDefault();const from=e.dataTransfer.getData('text/plain')||dragPreviewId,to=el.dataset.previewImage;if(!from||from===to)return;const list=m.imageSource==='ai'?m.aiSlots:m.existingImages,fi=list.findIndex(x=>(m.imageSource==='ai'?x.id:x.id)===from),ti=list.findIndex(x=>x.id===to);if(fi<0||ti<0)return;const[item]=list.splice(fi,1);list.splice(ti,0,item);renderQuickMedia(m);if(m.id===state.activeMomentId)renderImages();saveDraft();toast('图片顺序已调整')}})}
function validate(){const errors=[];if(!state.taskName.trim())errors.push('请填写任务名称');if(!state.employees.length)errors.push('请选择发布员工');if(state.audienceSource==='ai'&&!state.smartApplied)errors.push('请生成并使用AI人群');if(state.audienceSource==='tag'&&state.audienceMode==='partial'&&!state.tags.length)errors.push('请选择客户标签');state.moments.forEach((m,i)=>{const st=statusOf(m);if(!st.ok)errors.push(`第${i+1}条朋友圈${st.issue.replace('待完善：','缺少')}`);if(m.sendMode==='custom'&&m.customTime&&new Date(m.customTime)<=new Date())errors.push(`第${i+1}条发布时间不能早于当前时间`);if(m.validityMode==='custom'&&m.validityTime){const start=m.sendMode==='custom'?new Date(m.customTime):new Date();if(new Date(m.validityTime)<=start)errors.push(`第${i+1}条发布有效期必须晚于发布时间`)}});if(errors.length){toast(errors[0]);return false}return true}
function audienceSummary(){if(state.audienceSource==='ai')return`${state.smartAudience?.name||'AI人群'}，预计${Number(state.smartAudience?.estimated||0).toLocaleString()}人`;return state.audienceMode==='all'?`全部客户，预计${Number(state.estimated||3680).toLocaleString()}人`:`部分客户（${state.tags.join('、')}），预计${Number(state.estimated||0).toLocaleString()}人`}
function openTaskConfirm(){if(!validate())return;const list=orderedMoments();$('confirmTaskName').textContent=state.taskName;$('confirmEmployees').textContent=`${state.employees.length}人（${state.employees.map(e=>e.name).join('、')}）`;$('confirmAudience').textContent=audienceSummary();$('confirmMomentCount').textContent=`${list.length}条`;$('confirmScheduleList').innerHTML=`<div class="confirm-schedule-head"><span>序号</span><span>规则名称</span><span>发布时间</span><span>发布有效期</span></div>${list.map((m,i)=>`<div class="confirm-schedule-row"><span>${i+1}</span><span class="name">${escapeHtml(m.name)}</span><span>${scheduleText(m)}</span><span>${validityText(m)}</span></div>`).join('')}`;openModal('taskConfirmModal')}
function hydrate(){loadDraft();prepareDom();renderAll();saveDraft(true)}
hydrate();
})();
</script>
</body>
</html>
