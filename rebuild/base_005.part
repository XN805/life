.form-section>.section-title{letter-spacing:.01em}

/* v4.6 static media attachment placeholder */
.media-attachment-subsection{background:#fff;border-top:1px solid var(--line-soft)}
.media-attachment-static{min-height:64px;border:1px dashed #c8d4e4;border-radius:9px;background:#fbfcfe;display:flex;align-items:center;gap:14px;padding:14px 16px}
.media-attachment-button{border-color:#b9cdf2;color:var(--brand);background:#fff;font-weight:600;pointer-events:none;cursor:default}
.media-attachment-plus{font-size:18px;line-height:1}
.media-attachment-hint{font-size:12px;color:var(--muted)}
@media(max-width:680px){.media-attachment-static{align-items:flex-start;flex-direction:column;gap:8px}}


/* v4.7：发布时间区域右侧保存并收起 */
.moment-schedule-layout{display:grid;grid-template-columns:minmax(0,820px) auto;gap:20px;align-items:center}
.moment-schedule-layout .moment-time-field{max-width:none!important;min-width:0}
.save-collapse-btn{min-width:116px;height:38px;justify-self:end;white-space:nowrap}
.moment-module-actions .editing-label{display:inline-flex;align-items:center;height:29px;padding:0 9px;border-radius:5px;background:var(--brand-soft);color:var(--brand);font-size:12px;font-weight:600}
@media(max-width:980px){.moment-schedule-layout{grid-template-columns:1fr}.save-collapse-btn{justify-self:end}}


/* v4.8 素材中心文件夹树 */
.folder-field-inline{display:inline-flex;align-items:center;gap:8px;color:#475467;font-size:13px}
.folder-select-trigger{height:36px;min-width:220px;max-width:360px;border:1px solid #d7deea;background:#fff;border-radius:7px;padding:0 10px;display:inline-flex;align-items:center;justify-content:space-between;gap:12px;color:#344054;cursor:pointer;text-align:left}
.folder-select-trigger:hover{border-color:#aebbd0}.folder-select-trigger:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px rgba(50,120,246,.11)}
.folder-select-trigger.full{width:100%;max-width:none}.folder-select-main{display:flex;align-items:center;gap:8px;min-width:0}.folder-select-main>span:last-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.folder-glyph{color:#e7ad28;font-size:15px}.folder-chevron{color:#7a8799;font-size:16px}
.material-center-dialog{width:min(1120px,94vw)}.material-center-body{padding:0!important}.material-center-layout{display:grid;grid-template-columns:280px minmax(0,1fr);min-height:510px}.material-folder-panel{border-right:1px solid var(--line);background:#fbfcfe;display:flex;flex-direction:column;min-width:0}.material-folder-head{padding:15px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:8px}.material-folder-head .btn.text{padding:0 3px}.material-content-panel{padding:16px 18px;min-width:0}.material-current-folder{display:grid;gap:2px}.material-current-folder b{font-size:14px}.material-toolbar{margin-bottom:14px;min-height:38px}.material-grid{max-height:445px}
.folder-tree{padding:8px 6px;overflow:auto;flex:1}.folder-tree-row{height:36px;border-radius:6px;display:flex;align-items:center;gap:5px;padding-right:8px;color:#475467;cursor:pointer;user-select:none}.folder-tree-row:hover{background:#f0f4fa}.folder-tree-row.active{background:#eaf2ff;color:var(--brand);font-weight:600}.folder-tree-toggle{width:18px;height:24px;border:0;background:transparent;color:#8a95a6;padding:0;display:grid;place-items:center;cursor:pointer;font-size:11px}.folder-tree-toggle.placeholder{visibility:hidden}.folder-tree-icon{width:20px;color:#e8ad26;font-size:15px;flex:0 0 auto}.folder-tree-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}.folder-tree-count{font-size:11px;color:#98a2b3}.folder-tree-row.active .folder-tree-count{color:#6f9be9}.folder-tree-all{border-bottom:1px solid #edf0f5;margin-bottom:5px;padding-bottom:5px}
.folder-picker-dialog{width:min(620px,90vw)}.folder-picker-summary{padding:10px 12px;background:#f7f9fc;border:1px solid var(--line);border-radius:8px;display:flex;align-items:center;gap:10px;color:#667085}.folder-picker-summary b{color:#344054}.folder-picker-toolbar{display:flex;gap:8px;margin:12px 0}.folder-picker-tree{height:320px;border:1px solid var(--line);border-radius:8px;background:#fff}.folder-create-dialog{width:min(500px,90vw)}.folder-create-form{display:grid;gap:16px}.folder-create-form label{display:grid;grid-template-columns:92px minmax(0,1fr);gap:12px;align-items:center;color:#475467;font-weight:600}.folder-parent-display{height:36px;border:1px solid #e4e8ef;background:#f7f9fc;border-radius:7px;padding:7px 10px;color:#667085;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
@media(max-width:980px){.material-center-layout{grid-template-columns:220px minmax(0,1fr)}.material-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}


/* v4.8.1 信息减法、素材统一与就近预览 */
.basic-info-section{padding-bottom:20px}.basic-info-card{padding:18px}.basic-info-row{display:grid;grid-template-columns:minmax(240px,.65fr) minmax(420px,1.35fr);gap:24px;align-items:center}.basic-info-row .title-input-wrap{width:100%}
.moment-module-head{padding:12px 16px}.moment-module-ident{grid-template-columns:auto minmax(180px,360px) auto!important;gap:10px!important;flex:1}.rule-name-wrap{position:relative;min-width:0}.rule-name-input{width:100%;height:34px;padding:0 58px 0 10px;border:1px solid transparent;background:transparent;border-radius:6px;font-weight:700;color:#1f2937;outline:none}.rule-name-input:hover{border-color:#d7deea;background:#fff}.rule-name-input:focus{border-color:var(--brand);background:#fff;box-shadow:0 0 0 2px rgba(50,120,246,.10)}.rule-name-count{position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:11px;color:#98a2b3;pointer-events:none}.moment-module-ident .badge{justify-self:start}.moment-module-actions{flex:0 0 auto}.moment-module-summary{grid-template-columns:170px minmax(280px,1fr) 110px!important}.summary-material b{font-weight:700}.module-issue{grid-column:1/-1}
.schedule-config-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.schedule-config-block{min-width:0;padding:14px;border:1px solid var(--line);border-radius:10px;background:#fff}.schedule-config-block .moment-subsection-title{margin-bottom:10px}.schedule-config-block .moment-time-options{grid-template-columns:repeat(2,minmax(0,1fr))!important}.validity-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.validity-option{min-height:76px;border:1px solid #d7deea;border-radius:9px;padding:12px;display:flex;gap:9px;align-items:flex-start;cursor:pointer;background:#fff}.validity-option:has(input:checked){border-color:#a9c7ff;background:#f7faff}.validity-option input{accent-color:var(--brand);margin-top:3px}.validity-option span{display:grid;gap:3px}.validity-option small{font-size:12px;color:#7a8799}.custom-validity-input{width:100%;margin-top:10px}.custom-validity-input.time-invalid{border-color:var(--danger)!important;box-shadow:0 0 0 2px rgba(229,72,77,.10)!important}.schedule-action-row{display:flex;justify-content:flex-end;margin-top:16px}.save-collapse-btn{justify-self:auto!important}
.existing-image-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.existing-drop-area.material-entry{grid-column:1/-1;min-height:150px}.existing-material-card{grid-column:1/-1;border:1px solid var(--line);border-radius:10px;padding:16px;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#fff}.existing-material-main{display:flex;align-items:center;gap:12px;min-width:0}.existing-material-icon{width:48px;height:48px;border-radius:10px;background:var(--brand-soft);color:var(--brand);display:grid;place-items:center;font-size:22px;flex:0 0 auto}.existing-material-info{display:grid;gap:4px;min-width:0}.existing-material-info b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.existing-material-actions{display:flex;gap:8px;flex:0 0 auto}
.material-type-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.material-type-card{border:1px solid var(--line);border-radius:10px;background:#fff;padding:18px;text-align:left;display:grid;grid-template-columns:42px 1fr;grid-template-rows:auto auto;column-gap:12px;cursor:pointer}.material-type-card:hover{border-color:#a9c7ff;background:#f8fbff}.material-type-icon{grid-row:1/3;width:42px;height:42px;border-radius:9px;background:var(--brand-soft);color:var(--brand);display:grid;place-items:center;font-size:20px}.material-type-card b{font-size:14px}.material-type-card small{font-size:12px;color:#7a8799;margin-top:3px}
.quick-preview-dialog{width:min(760px,92vw)}.quick-preview-body{display:grid;grid-template-columns:minmax(220px,1fr) 340px;gap:24px;align-items:start}.quick-preview-summary{display:grid;gap:0;border:1px solid var(--line);border-radius:10px;background:#fbfcfe}.quick-preview-summary>div{padding:13px 14px;border-bottom:1px solid var(--line-soft);display:grid;gap:5px}.quick-preview-summary>div:last-child{border-bottom:0}.quick-preview-summary span{font-size:12px;color:#7a8799}.quick-preview-summary b{font-size:13px;color:#344054}.quick-preview-phone{width:330px!important;height:540px!important;margin:0 auto}.phone-material-card{margin-top:10px;border:1px solid #e1e6ef;border-radius:8px;background:#f7f9fc;padding:10px;display:flex;align-items:center;gap:9px}.phone-material-card .icon{width:36px;height:36px;border-radius:7px;background:#eaf2ff;color:var(--brand);display:grid;place-items:center;flex:0 0 auto}.phone-material-card .info{display:grid;gap:2px;min-width:0}.phone-material-card b{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.phone-material-card span{font-size:11px;color:#8a95a6}
.dispatch-summary-six{grid-template-columns:repeat(3,minmax(0,1fr))!important}.dispatch-summary-six .dispatch-row{display:block;padding:12px 14px;border-bottom:1px solid var(--line-soft);border-right:1px solid var(--line-soft)}.dispatch-summary-six .dispatch-row:nth-child(3n){border-right:0}.dispatch-summary-six .dispatch-row:nth-last-child(-n+3){border-bottom:0}.dispatch-summary-six .dispatch-key{display:block;margin-bottom:7px}.dispatch-summary-six .dispatch-value{min-height:28px}.sop-overview-row{grid-template-columns:48px 140px minmax(150px,.7fr) minmax(180px,1.3fr) 86px 82px 68px!important}
@media(max-width:1100px){.basic-info-row{grid-template-columns:1fr}.schedule-config-grid{grid-template-columns:1fr}.quick-preview-body{grid-template-columns:1fr}.dispatch-summary-six{grid-template-columns:repeat(2,minmax(0,1fr))!important}.dispatch-summary-six .dispatch-row:nth-child(3n){border-right:1px solid var(--line-soft)}.dispatch-summary-six .dispatch-row:nth-child(2n){border-right:0}.dispatch-summary-six .dispatch-row:nth-last-child(-n+3){border-bottom:1px solid var(--line-soft)}.dispatch-summary-six .dispatch-row:nth-last-child(-n+2){border-bottom:0}}
@media(max-width:680px){.moment-module-ident{grid-template-columns:auto minmax(0,1fr)!important}.moment-module-ident .badge{grid-column:2}.moment-module-actions{width:100%;justify-content:flex-end}.moment-module-summary{grid-template-columns:1fr!important}.validity-options,.material-type-grid{grid-template-columns:1fr}.dispatch-summary-six{grid-template-columns:1fr!important}.dispatch-summary-six .dispatch-row{border-right:0!important;border-bottom:1px solid var(--line-soft)!important}.dispatch-summary-six .dispatch-row:last-child{border-bottom:0!important}.quick-preview-phone{width:min(330px,100%)!important}}

</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div class="logo">慧</div><div>慧企SCRM</div></div>
    <div class="menu">
      <div class="menu-item">运营日历</div><div class="menu-item">客户运营<span class="arrow">⌄</span></div><div class="menu-item">群聊运营<span class="arrow">⌄</span></div><div class="menu-item">朋友圈运营<span class="arrow">⌃</span></div>
      <div class="menu-child"><div>朋友圈管理</div><div class="active">发布朋友圈</div><div>发布计划</div><div>朋友圈统计</div></div>
    </div>
  </aside>
  <main class="main">
    <div class="shell">
      <section id="listPage" class="page active">
        <div class="topbar"><div class="title-row"><div class="title">发布朋友圈</div><div class="sub">创建群发任务并通知成员发送，可用于商品/活动推广、日常客情维护、品牌宣传</div></div><div class="row"><button class="btn primary">更新数据</button><button class="btn text">查看功能说明</button></div></div>
        <div class="notice">每位客户的微信朋友圈每天最多可展示 3 条成员发表的内容，企业和成员每天共用客户 3 条频率，请合理使用发表次数。</div>
        <div class="filterbar"><div class="field">任务名称：<input class="input" style="width:180px" placeholder="请输入任务名称"></div><div class="field">朋友圈内容：<input class="input" style="width:180px" placeholder="请输入朋友圈内容"></div><div class="field">发布状态：<select class="select" style="width:120px"><option>不限</option></select></div><button class="btn primary">查询</button><button class="btn">重置</button></div>
        <div class="table-actions"><button id="openAiBtn" class="btn primary">创建AI朋友圈</button></div>
        <table><thead><tr><th>任务名称</th><th>朋友圈内容</th><th>发布状态</th><th>任务下发进度</th><th>已发表/需发表</th><th>客户点赞</th><th>客户评论</th><th>创建人</th><th>创建时间</th><th>操作</th></tr></thead><tbody>
          <tr><td class="link">0528测试1-副本</td><td><div class="row"><div class="thumb">图</div>哈哈哈哈</div></td><td>已完成</td><td class="link">1/1</td><td>0/1</td><td>-</td><td>-</td><td>张三</td><td>2026-05-28 14:33</td><td><span class="link">详情</span>　<span class="link" style="color:#ef4444">删除</span></td></tr>
          <tr><td class="link">双11连衣裙活动</td><td><div class="row"><div class="thumb">图</div>双11活动提醒...</div></td><td>待发布</td><td class="link">0/3</td><td>0/3</td><td>-</td><td>-</td><td>王超</td><td>2026-07-15 10:40</td><td><span class="link">详情</span>　<span class="link" style="color:#ef4444">删除</span></td></tr>
        </tbody></table>
        <div class="pager"><span>共 25 条</span><div class="page-btn">‹</div><div class="page-btn active">1</div><div class="page-btn">2</div><div class="page-btn">3</div><div class="page-btn">›</div></div>
      </section>

      <section id="aiPage" class="page">
        <div class="ai-head"><div class="title-row"><div class="title">创建AI朋友圈</div><div class="sub">默认创建一个朋友圈任务，需要连续发布时可按需新增</div></div><div class="row"><div class="draft-state"><span class="badge blue">草稿</span><span id="draftStatus">未修改</span></div><button id="backListBtn" class="btn primary">返回</button></div></div>
        <div id="workspace" class="workspace form-workspace">
          <div id="step1Panel" class="form-section audience-step-panel">
            <div class="section-title">第一步：设置推送范围</div><div class="section-desc">选择负责发布的员工，并确定本次朋友圈可见的客户范围。</div>
            <div class="surface employee-scope-card" style="margin-bottom:16px">
              <div class="surface-hd"><div><div class="label required">发布员工</div><div class="tiny">选择负责执行本次朋友圈发布的员工</div></div><button id="chooseEmployeesBtn" class="btn primary">选择员工</button></div>
              <div class="surface-bd"><div id="employeeResult" class="employee-result"><span class="tiny">尚未选择员工</span></div></div>
            </div>
            <div class="audience-source-switch" role="tablist" aria-label="圈人方式">
              <button class="audience-source-tab active" data-audience-source="ai" type="button"><span class="sparkle">✦</span> AI智能圈人</button>
              <button class="audience-source-tab" data-audience-source="tag" type="button">标签圈人</button>
            </div>
            <div id="aiAudiencePanel" class="surface audience-source-panel smart-audience-panel">
              <div id="smartAudienceCreate" class="smart-create-view">
                <div class="smart-query-box">
                  <div class="smart-icon">✦</div>
                  <input id="smartAudienceQuery" class="smart-query-input" maxlength="100" placeholder="描述想要的人群，例如：帮我看看近期入会但还没购买的用户有哪些" />
                  <button id="smartCreateBtn" class="btn primary large" type="button">开始创建</button>
                </div>
                <div class="smart-suggestions"><span class="smart-suggest-label">猜你想找：</span><button type="button" data-smart-suggest="请帮我创建已购买但未入会人群">已购买未入会</button><button type="button" data-smart-suggest="圈选所有收藏加购但还未购买的用户">收藏加购未购买</button><button type="button" data-smart-suggest="帮我创建有访问无购买人群">有访问无购买</button><button type="button" data-smart-suggest="帮我查找店铺会员人群">店铺会员</button><button type="button" data-smart-suggest="创建180天已购买会员人群">180天已购会员</button></div>
                <div class="smart-disclaimer">AI生成结果仅供参考，请在使用前核对人群条件。</div>
              </div>
              <div id="smartAudienceReport" class="smart-report hidden">
                <div class="smart-report-head"><div><div class="smart-report-title-row"><strong id="smartAudienceName">AI人群</strong><span id="smartAppliedBadge" class="badge green hidden">已使用</span></div><div class="tiny">根据你的描述生成</div></div><div class="row"><span class="smart-confidence"><i></i><span id="smartConfidence">高置信度</span></span><span class="smart-size">预计规模：<b id="smartEstimatedSize">0</b></span></div></div>
                <div class="smart-insight"><div class="smart-insight-title">💡 AI洞察</div><div id="smartAudienceInsight"></div></div>
                <div class="smart-rule-block"><div class="row between"><div><div class="smart-rule-title">人群条件</div><div class="tiny">以下条件取交集</div></div><button id="adjustSmartAudienceBtn" class="btn text" type="button">重新调整</button></div><div id="smartRuleChips" class="smart-rule-chips"></div></div>
                <div class="smart-report-actions"><button id="regenerateSmartAudienceBtn" class="btn" type="button">重新生成</button><button id="applySmartAudienceBtn" class="btn primary" type="button">使用该人群</button></div>
              </div>
            </div>
            <div id="tagAudiencePanel" class="surface audience-source-panel hidden"><div class="audience-form">
              <div class="form-row"><div class="form-label required">可见客户</div><div class="row" style="padding-top:5px"><label class="radio"><input id="audienceAll" type="radio" name="audience" value="all" checked> 全部客户</label><label class="radio"><input id="audiencePartial" type="radio" name="audience" value="partial"> 部分客户</label></div></div>
              <div id="tagRow" class="form-row hidden"><div class="form-label"></div><div><button id="chooseTagsBtn" class="btn">选择标签</button><div id="selectedTagResult" class="tag-result" style="margin-top:10px"><span class="tiny">尚未选择标签</span></div></div></div>
              <div class="form-row"><div class="form-label required">估算人数</div><div><button id="estimateBtn" class="btn">估算推送人数</button><div id="estimateResult" class="estimate-box hidden"></div></div></div>
            </div></div>
          </div>
          <div id="step2Panel" class="form-section sop-content-section">
            <div class="section-title">第二步：设置朋友圈内容</div>
            <div class="section-desc">默认创建一个朋友圈任务。需要连续发布预热、宣传、提醒等内容时，可在完成当前任务后继续新增，最多10个。</div>
            <div class="moment-content-toolbar">
              <div><span class="label">朋友圈任务</span><span id="momentCountLabel" class="tiny moment-count-label">当前 1 个任务，最多 10 个</span></div>
            </div>
            <div id="momentList" class="moment-modules"></div>
            <div id="momentEditorParking" class="hidden"><div id="momentEditor" class="moment-editor surface">
                <div class="moment-editor-head">
                  <div><div class="label">内容设置</div><div class="tiny">本模块内的任务名称、文案、图片和发布时间仅作用于当前朋友圈任务</div></div>
                  
                </div>
                <div class="moment-subsection moment-name-subsection">
                  <div class="moment-task-name-row">
                    <div><div class="moment-subsection-title">任务名称</div><div class="tiny">用于后台区分和管理当前朋友圈任务，每条朋友圈使用独立名称。</div></div>
                    <div class="title-input-wrap moment-task-name-input"><input id="momentName" class="input" maxlength="20" placeholder="例如：618活动预热"><span id="momentNameCount">0/20</span></div>
                  </div>
                </div>