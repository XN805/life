.compact-copy-list .copy-option-text{-webkit-line-clamp:2;font-size:12px;line-height:1.45;margin:0}
.compact-copy-list .badge{height:20px}
.empty-copy-state{grid-row:1/-1;display:grid;place-items:center;padding:0}
.compact-editor-box{padding:12px;display:flex;flex-direction:column}
.compact-final-editor{min-height:0;height:auto;flex:1;resize:none}
.image-context-bar{margin:0 0 10px}
.slot-context{font-size:12px;color:#667085;padding:7px 9px;background:#f8fafc;border:1px solid #edf1f6;border-radius:6px;margin-bottom:8px;line-height:1.45}
#step4Panel .review-layout{flex:1;min-height:0;grid-template-columns:minmax(0,1fr) 360px;gap:18px;align-items:stretch}
#step4Panel .review-left{min-height:0;overflow:auto;align-content:start;gap:10px;padding-right:2px}
#step4Panel .review-section .surface-hd{padding:10px 13px}
#step4Panel .review-section .surface-bd{padding:11px 13px}
#step4Panel .risk-grid{gap:7px}
#step4Panel .risk-card{padding:8px 9px}
.recommend-basis{margin-top:8px;padding-top:7px;border-top:1px dashed #d7e2f4;color:#63738a;font-size:12px}
.phone-wrap{position:relative;top:auto;height:100%;min-height:0;display:flex;flex-direction:column}
.phone-title{margin-bottom:7px}
.phone{width:min(330px,100%);height:clamp(450px,calc(100vh - 290px),550px);border-radius:26px;padding:11px 13px 13px;flex:0 0 auto}
.phone-status{height:22px}.phone-nav{height:38px}.moment{height:calc(100% - 60px);padding:11px 1px;overflow:auto}
.avatar{width:38px;height:38px}.moment-copy{font-size:13px;line-height:1.55}.moment-images{max-width:235px}
@media(max-height:780px){.workspace.fit-view{overflow:auto}.phone{height:470px}.compact-goal{height:58px;min-height:58px}.compact-copy-list{gap:4px}.compact-copy-list .copy-option{padding:6px 8px}}
@media(max-width:1240px){.compact-copy-layout{grid-template-columns:420px minmax(0,1fr)}#step4Panel .review-layout{grid-template-columns:minmax(0,1fr) 330px}.phone{width:315px}}


/* v19 fit correction */
.compact-copy-list{gap:4px}
.compact-copy-list .copy-option{padding:6px 8px}
.compact-copy-list .copy-option-text{line-height:1.35;-webkit-line-clamp:2}


/* v19 candidate density correction */
.compact-copy-list .copy-option{padding:4px 7px;grid-template-columns:150px minmax(0,1fr)}
.compact-copy-list .copy-option-title{flex-direction:row;align-items:center;gap:6px;white-space:nowrap}
.compact-copy-list .copy-option-text{line-height:1.3;-webkit-line-clamp:1;white-space:normal}


.review-audience{margin:0;padding:7px 10px;background:#fbfcfe}
@media(max-height:780px){
  .ai-head{height:58px}
  .step-strip{height:50px}
  .workspace{padding-top:10px;padding-bottom:72px}
  .workspace.fit-view{overflow:hidden}
  #step4Panel .section-desc{display:none}
  #step4Panel .review-layout{gap:14px}
  #step4Panel .review-left{gap:6px}
  #step4Panel .review-section .surface-hd{padding:7px 10px}
  #step4Panel .review-section .surface-bd{padding:7px 10px}
  #step4Panel .risk-card{padding:5px 7px}
  #step4Panel .risk-card b{margin-bottom:1px}
  #step4Panel .risk-card span{line-height:1.25}
  #step4Panel .time-card{padding:7px 9px}
  #step4Panel .time-card .row[style*="margin-top:12px"]{margin-top:7px!important}
  .recommend-basis{margin-top:5px;padding-top:5px}
  .employee-result{min-height:36px;padding:5px 8px}
  .review-audience{padding:5px 8px}
  .phone-title{margin-bottom:4px}
  .phone{height:410px;width:300px;padding:8px 10px 10px}
  .phone-status{height:18px}.phone-nav{height:34px}.moment{height:calc(100% - 52px);padding:8px 1px}
  .avatar{width:34px;height:34px}.moment-copy{font-size:12px;line-height:1.42}.moment-images{max-width:205px}
}


/* v20 merchant-facing refinements */
#step2Panel .section-desc{margin-bottom:8px}
.compact-copy-layout{grid-template-columns:minmax(620px,1.55fr) minmax(340px,.85fr);gap:16px}
.copy-source-panel{min-width:0}
.compact-generator{padding:14px;display:grid;grid-template-rows:auto auto 78px auto minmax(0,1fr);gap:8px}
.copy-config-head{align-items:center}
.copy-toolbar{margin-top:0;align-items:center}
.compact-goal{height:78px;min-height:78px}
.candidate-head{margin:0 0 2px}
.compact-copy-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:minmax(86px,1fr);grid-template-rows:none;gap:8px;min-height:0;overflow:visible}
.compact-copy-list .copy-option{display:block;min-height:86px;padding:9px 10px}
.compact-copy-list .copy-option-title{display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:8px;font-size:12px}
.compact-copy-list .copy-option-text{margin-top:6px;-webkit-line-clamp:2;font-size:12px;line-height:1.45}
.compact-editor-box{padding:14px;min-width:0}
.compact-final-editor{min-height:0;height:auto;flex:1}
#copyAudienceContext,#imageGenerationContext,#recommendBasis{display:none!important}
.image-step-head .section-desc{max-width:620px}
.slot-context{display:none!important}
.review-audience{margin:0!important;padding:9px 11px!important}
.confirm-summary{display:grid;gap:10px}
.confirm-row{display:grid;grid-template-columns:110px minmax(0,1fr);gap:14px;padding:10px 0;border-bottom:1px solid var(--line-soft);font-size:13px}
.confirm-row:last-child{border-bottom:0}
.confirm-row .k{color:#667085}.confirm-row .v{color:#1f2937;font-weight:600;text-align:right}
.confirm-warning{margin-bottom:12px;padding:10px 12px;border-radius:8px;background:#fff7e8;color:#9a5b00;font-size:13px}
@media(max-width:1180px){.compact-copy-layout{grid-template-columns:minmax(0,1.35fr) minmax(320px,.75fr)}}


/* v21: audience source switch + smart targeting */
.audience-step-panel{max-width:980px}
.audience-source-switch{display:inline-flex;align-items:center;padding:4px;border:1px solid #dfe5ef;border-radius:9px;background:#f6f8fb;margin:0 0 14px}
.audience-source-tab{height:34px;border:0;border-radius:6px;background:transparent;color:#667085;padding:0 18px;font-weight:600;cursor:pointer}
.audience-source-tab.active{background:#fff;color:var(--brand);box-shadow:0 1px 5px rgba(16,24,40,.10)}
.audience-source-tab .sparkle{margin-right:5px}
.audience-source-panel{min-height:250px}
.smart-audience-panel{padding:22px 24px}
.smart-create-view{display:flex;flex-direction:column;gap:14px}
.smart-query-box{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:12px;align-items:center}
.smart-icon{width:44px;height:44px;border-radius:9px;background:#111827;color:#fff;display:grid;place-items:center;font-size:20px}
.smart-query-input{height:52px;border:1px solid #d8dfeb;border-radius:8px;padding:0 16px;font-size:16px;color:#27364c;outline:none}
.smart-query-input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(47,124,246,.10)}
.smart-suggestions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding-left:56px}
.smart-suggest-label{font-size:12px;color:#8a95a6}
.smart-suggestions button{height:28px;border:1px solid #e4e8ef;border-radius:6px;background:#f8f9fb;color:#526074;padding:0 10px;font-size:12px;cursor:pointer}
.smart-suggestions button:hover{border-color:#b8cef5;color:var(--brand);background:#f4f8ff}
.smart-disclaimer{font-size:12px;color:#a0a8b5;padding-left:56px}
.smart-report{border:1px solid #e1e6ee;border-radius:10px;background:#f8f9fb;padding:18px 20px;box-shadow:0 3px 12px rgba(16,24,40,.05)}
.smart-report-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.smart-report-title-row{display:flex;align-items:center;gap:8px;font-size:16px}
.smart-confidence,.smart-size{height:34px;display:inline-flex;align-items:center;border:1px solid #e2e7ef;border-radius:8px;background:#fff;padding:0 12px;font-size:12px;color:#4b586b}
.smart-confidence i{width:7px;height:7px;border-radius:50%;background:#13a36b;margin-right:7px}
.smart-size{background:#5146e5;color:#fff;border-color:#5146e5;font-size:13px}
.smart-size b{font-size:17px;margin-left:5px}
.smart-insight{margin-top:16px;border:1px solid #e0e6ef;border-radius:8px;background:#fff;padding:13px 14px;color:#41516a;line-height:1.65}
.smart-insight-title{font-size:12px;color:#6f7d91;margin-bottom:5px;font-weight:600}
.smart-rule-block{margin-top:14px}
.smart-rule-title{font-size:12px;color:#7c8798;font-weight:600}
.smart-rule-chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.smart-rule-chip{display:inline-flex;align-items:center;gap:7px;height:30px;padding:0 10px;border-radius:7px;background:#eef4ff;color:#335f9f;font-size:12px;border:1px solid #d9e6fa}
.smart-rule-chip::before{content:'•';color:#4d62e8;font-size:17px;line-height:1}