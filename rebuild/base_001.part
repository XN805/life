<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>发布朋友圈 · AI朋友圈 v4.8.2</title>
<style>
:root{
  --brand:#3278f6;--brand-hover:#2569df;--brand-soft:#edf4ff;--brand-line:#cfe0ff;
  --text:#1f2937;--text-2:#475467;--muted:#7a8799;--line:#e5eaf2;--line-soft:#eef2f7;
  --surface:#fff;--canvas:#f4f6f9;--success:#0f9f67;--success-soft:#eaf8f2;
  --warning:#c77800;--warning-soft:#fff6e8;--danger:#e5484d;--danger-soft:#fff1f1;
  --shadow:0 10px 30px rgba(15,23,42,.07);--radius:10px;
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden}
body{background:var(--canvas);color:var(--text);font:14px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",Arial,sans-serif}
button,input,textarea,select{font:inherit}button{cursor:pointer}
.app{height:100%;display:flex;overflow:hidden}
.sidebar{width:216px;flex:0 0 216px;background:#fff;border-right:1px solid var(--line);padding:18px 14px}
.brand{display:flex;flex-direction:column;align-items:center;gap:9px;padding:4px 0 24px;color:#4b5563}.logo{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#b00096,#7a2ee6);color:#fff;font-size:21px;font-weight:800}
.menu{display:grid;gap:4px}.menu-item{height:42px;border-radius:6px;display:flex;align-items:center;padding:0 12px;color:#394150}.menu-item .arrow{margin-left:auto;color:#9aa3b2}.menu-child{padding-left:18px;display:grid;gap:3px;margin:2px 0 8px}.menu-child div{height:38px;border-radius:5px;display:flex;align-items:center;padding:0 12px;color:#596274}.menu-child div.active{background:var(--brand);color:#fff}
.main{flex:1;padding:18px;min-width:0;overflow:hidden}.shell{position:relative;height:calc(100vh - 36px);background:#fff;border-radius:9px;box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column}.page{display:none;height:100%}.page.active{display:flex;flex-direction:column}
.topbar{height:58px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 20px;flex:0 0 auto}.title-row{display:flex;align-items:baseline;gap:10px}.title{font-size:18px;font-weight:700}.sub{font-size:13px;color:var(--muted)}
.btn{height:34px;border:1px solid #d6ddea;background:#fff;border-radius:5px;padding:0 14px;color:#344054;display:inline-flex;align-items:center;justify-content:center;gap:6px}.btn:hover{border-color:#b9c6da}.btn.primary{background:var(--brand);border-color:var(--brand);color:#fff}.btn.primary:hover{background:var(--brand-hover)}.btn.text{border:0;background:transparent;color:var(--brand);padding:0 6px}.btn.danger{color:var(--danger);border-color:#f2c8cb}.btn.small{height:29px;padding:0 10px;font-size:12px}.btn.large{height:40px;padding:0 20px;font-weight:600}.btn:disabled{opacity:.5;cursor:not-allowed}
.input,.select,.textarea{border:1px solid #d7deea;background:#fff;border-radius:7px;color:var(--text);outline:none}.input,.select{height:36px;padding:0 11px}.textarea{width:100%;padding:11px 12px;resize:vertical;line-height:1.65}.input:focus,.select:focus,.textarea:focus{border-color:var(--brand);box-shadow:0 0 0 2px rgba(50,120,246,.11)}
.badge{height:22px;display:inline-flex;align-items:center;padding:0 8px;border-radius:11px;font-size:12px;white-space:nowrap}.badge.blue{background:var(--brand-soft);color:var(--brand)}.badge.green{background:var(--success-soft);color:var(--success)}.badge.orange{background:var(--warning-soft);color:var(--warning)}.badge.gray{background:#f1f3f6;color:#667085}.badge.red{background:var(--danger-soft);color:var(--danger)}
.link{color:var(--brand);cursor:pointer}.tiny{font-size:12px;color:var(--muted)}.hidden{display:none!important}
.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.row.between{justify-content:space-between}.label{font-weight:700;color:#111827}.divider{height:1px;background:var(--line-soft);margin:16px 0}.radio{display:inline-flex;align-items:center;gap:7px;cursor:pointer}.radio input{accent-color:var(--brand)}
.notice{margin:14px 18px 0;background:#fff9ef;color:#b36a00;padding:9px 14px;font-size:13px}.filterbar{margin:14px 18px 0;background:#f7f9fc;padding:14px;display:flex;gap:20px;align-items:center;flex-wrap:wrap}.field{display:flex;align-items:center;gap:8px;color:#3f4858}.table-actions{padding:16px 18px;display:flex;gap:10px}
table{width:calc(100% - 36px);margin:0 18px;border-collapse:collapse;border:1px solid var(--line)}th{height:40px;background:#f4f7fb;text-align:left;padding:0 12px;color:#374151;font-weight:600;font-size:13px;border-bottom:1px solid var(--line)}td{height:72px;padding:9px 12px;border-bottom:1px solid #edf0f5;color:#303846;font-size:13px}.thumb{width:44px;height:44px;border-radius:5px;background:linear-gradient(135deg,#eff3fb,#ccd7e8);display:grid;place-items:center;color:#8a94a6}.pager{height:56px;margin:0 18px;display:flex;align-items:center;gap:8px;color:#667085}.page-btn{width:32px;height:32px;border:1px solid #d7ddea;border-radius:4px;display:grid;place-items:center;background:#fff}.page-btn.active{background:var(--brand);border-color:var(--brand);color:#fff}
.ai-head{height:70px;border-bottom:1px solid var(--line);padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex:0 0 auto}.draft-state{display:flex;align-items:center;gap:8px;font-size:12px;color:#667085}
.step-strip{height:78px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:center;padding:0 28px;background:#fbfcfe;flex:0 0 auto}.steps{width:min(1040px,100%);display:grid;grid-template-columns:repeat(4,1fr)}.step{position:relative;display:flex;align-items:center;gap:10px;color:#8a95a6;cursor:default}.step:not(:last-child)::after{content:'';position:absolute;left:38px;right:14px;top:14px;height:1px;background:#dce3ed}.step.done:not(:last-child)::after{background:#8db5ff}.step-dot{width:28px;height:28px;border-radius:50%;border:1px solid #ccd5e2;background:#fff;display:grid;place-items:center;font-size:12px;font-weight:700;z-index:1;flex:0 0 auto}.step.active,.step.done{color:#26364a}.step.active .step-dot{background:var(--brand);border-color:var(--brand);color:#fff}.step.done .step-dot{background:#e8f2ff;border-color:#9fc2ff;color:var(--brand)}.step-label{font-weight:600}.step-desc{font-size:12px;color:#8a95a6;margin-top:1px}
.workspace{flex:1;min-height:0;overflow:auto;padding:26px 30px 96px;background:#fff}.step-panel{margin:0 auto}.step-panel.compact{max-width:900px}.step-panel.medium{max-width:1120px}.step-panel.wide{max-width:1260px}
.section-title{font-size:17px;font-weight:700;margin-bottom:4px}.section-desc{font-size:13px;color:var(--muted);margin-bottom:20px}.surface{background:#fff;border:1px solid var(--line);border-radius:10px}.surface.soft{background:#fbfcfe}.surface-hd{padding:14px 16px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;gap:12px}.surface-bd{padding:16px}
.bottom-bar{height:72px;border-top:1px solid var(--line);background:rgba(255,255,255,.98);display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:absolute;bottom:0;left:0;right:0;z-index:10}.bottom-hint{font-size:12px;color:#8a95a6;position:absolute;left:50%;transform:translateX(-50%);white-space:nowrap}
/* step 1 */
.audience-form{padding:26px 30px}.form-row{display:grid;grid-template-columns:120px 1fr;align-items:start;gap:16px;padding:13px 0}.form-label{font-weight:600;padding-top:7px}.required::before{content:'*';color:var(--danger);margin-right:3px}.tag-result{min-height:44px;border:1px dashed #cfd9e8;border-radius:7px;background:#fbfcfe;padding:8px 10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}.tag-chip{height:26px;display:inline-flex;align-items:center;padding:0 9px;border-radius:13px;background:var(--brand-soft);color:var(--brand);font-size:12px}.estimate-box{margin-top:10px;padding:10px 12px;border-radius:7px;background:#f7faff;color:#475467;font-size:13px}
/* step 2 */
.source-switch{display:flex;gap:28px;border-bottom:1px solid var(--line);height:46px;align-items:flex-end;padding:0 4px;margin-bottom:18px}.source-tab{height:46px;display:flex;align-items:center;border-bottom:2px solid transparent;color:#667085;cursor:pointer}.source-tab.active{color:var(--brand);border-color:var(--brand);font-weight:600}
.copy-layout{display:grid;grid-template-columns:430px minmax(0,1fr);gap:18px;align-items:start}.generator-box{padding:16px}.template-chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 12px}.template-chip{height:30px;padding:0 12px;border:1px solid #d8dfeb;border-radius:15px;background:#fff;display:inline-flex;align-items:center;color:#475467;cursor:pointer}.template-chip.active{background:var(--brand-soft);border-color:#b9d0ff;color:var(--brand);font-weight:600}.copy-list{display:grid;gap:10px;margin-top:14px;max-height:430px;overflow:auto;padding-right:3px}.copy-option{border:1px solid var(--line);border-radius:9px;padding:12px;cursor:pointer;background:#fff}.copy-option:hover{border-color:#b9c9df}.copy-option.active{border-color:var(--brand);box-shadow:0 0 0 2px rgba(50,120,246,.08);background:#fbfdff}.copy-option-title{display:flex;justify-content:space-between;gap:8px;font-weight:600}.copy-option-text{font-size:13px;color:#475467;line-height:1.65;margin-top:7px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.editor-box{padding:16px;position:sticky;top:0}.editor-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px}.final-editor{min-height:330px}.char-count{text-align:right;font-size:12px;color:#8a95a6;margin-top:6px}.edit-warning{margin-top:12px;padding:10px 12px;border-radius:7px;background:var(--warning-soft);color:var(--warning);font-size:12px}
/* step 3 */
.image-step-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px}.no-image{padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:#fbfcfe}.slot-list{display:grid;gap:14px}.image-slot{border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden}.image-slot.stale{border-color:#f0c98a}.slot-head{height:50px;padding:0 14px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fbfcfe}.slot-title{font-weight:700}.slot-body{padding:14px;display:grid;grid-template-columns:190px minmax(280px,1fr) 230px;gap:14px;align-items:stretch}.slot-col{min-width:0}.slot-label{font-size:12px;font-weight:600;color:#475467;margin-bottom:7px}.mode-toggle{display:inline-flex;padding:3px;background:#f1f4f8;border-radius:7px;margin-bottom:10px}.mode-btn{height:28px;border:0;background:transparent;border-radius:5px;padding:0 10px;color:#667085}.mode-btn.active{background:#fff;color:var(--brand);box-shadow:0 1px 4px rgba(15,23,42,.09);font-weight:600}.upload-tile{height:132px;border:1px dashed #c8d4e4;border-radius:8px;background:#fbfcfe;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;color:#63738b;cursor:pointer;text-align:center;padding:10px}.upload-tile:hover{border-color:#9ebcf2;background:#f7faff}.plus{font-size:25px;line-height:1}.reference-list{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.mini-image{width:48px;height:48px;border:1px solid #dce5f1;border-radius:6px;object-fit:cover;background:#eef4ff}.slot-prompt{height:132px;resize:none}.slot-result{height:174px;border:1px dashed #c8d4e4;border-radius:8px;background:#fbfcfe;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;color:#8793a5;text-align:center}.slot-result img{width:100%;height:100%;object-fit:cover}.result-state{position:absolute;left:7px;top:7px}.slot-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:10px;flex-wrap:wrap}.slot-message{font-size:12px;color:var(--warning);margin-top:7px}.add-slot{height:64px;border:1px dashed #bfcde0;border-radius:10px;background:#fbfcfe;color:var(--brand);font-weight:600;display:flex;align-items:center;justify-content:center;gap:7px;cursor:pointer}.add-slot:hover{background:#f5f9ff;border-color:#9cbaf0}
/* step 4 */
.review-layout{display:grid;grid-template-columns:minmax(0,1.35fr) 390px;gap:22px;align-items:start}.review-left{display:grid;gap:14px}.review-section{border:1px solid var(--line);border-radius:10px;background:#fff}.review-section .surface-hd{padding:13px 15px}.review-section .surface-bd{padding:15px}.content-confirm{display:grid;grid-template-columns:1fr 260px;gap:14px}.copy-confirm{min-height:150px;background:#fbfcfe;border:1px solid var(--line-soft);border-radius:8px;padding:12px;white-space:pre-wrap;line-height:1.7}.image-confirm{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;align-content:start}.confirm-thumb{width:100%;aspect-ratio:1;border-radius:7px;object-fit:cover;border:1px solid #dce5f1;background:#f4f7fb}.risk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.risk-card{padding:11px;border:1px solid var(--line-soft);border-radius:8px;background:#fbfcfe}.risk-card b{display:block;font-size:13px;margin-bottom:4px}.risk-card span{font-size:12px;color:#667085}.time-card{padding:12px;border-radius:8px;background:#f7faff;border:1px solid #dce8ff}.employee-result{min-height:44px;border:1px dashed #cfd9e8;border-radius:7px;background:#fbfcfe;padding:8px 10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.phone-wrap{position:sticky;top:0}.phone-title{font-weight:700;margin-bottom:10px}.phone{width:365px;height:650px;border:1px solid #d9e0ea;border-radius:30px;background:#fff;margin:0 auto;box-shadow:0 10px 30px rgba(15,23,42,.09);padding:14px 15px 16px;overflow:hidden}.phone-status{height:26px;display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#344054}.phone-nav{height:42px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #f0f2f5}.phone-nav b{font-size:16px}.moment{padding:14px 2px;overflow:auto;height:555px}.user-line{display:flex;gap:10px;align-items:flex-start}.avatar{width:42px;height:42px;border-radius:5px;background:linear-gradient(135deg,#b9c7db,#eef2f7);flex:0 0 auto}.moment-main{min-width:0;flex:1}.user-name{color:#576b95;font-weight:600}.moment-copy{white-space:pre-wrap;margin-top:5px;line-height:1.62;font-size:14px}.moment-images{display:grid;gap:4px;margin-top:9px;max-width:255px}.moment-images.count-1{grid-template-columns:1fr;max-width:210px}.moment-images.count-2,.moment-images.count-4{grid-template-columns:repeat(2,1fr)}.moment-images.count-3,.moment-images.count-many{grid-template-columns:repeat(3,1fr)}.moment-image{width:100%;aspect-ratio:1;object-fit:cover;background:#f1f4f8}.moment-meta{display:flex;justify-content:space-between;align-items:center;margin-top:8px;color:#8a95a6;font-size:12px}.more-box{background:#f1f3f5;border-radius:3px;padding:0 8px;color:#576b95;font-weight:700;letter-spacing:1px}
/* modal */
.modal-mask{position:fixed;inset:0;background:rgba(15,23,42,.38);display:none;align-items:center;justify-content:center;z-index:100}.modal-mask.show{display:flex}.modal{width:min(1000px,92vw);max-height:88vh;background:#fff;border-radius:10px;box-shadow:0 24px 70px rgba(15,23,42,.24);display:flex;flex-direction:column;overflow:hidden}.modal.small{width:min(760px,90vw)}.modal-hd{height:58px;border-bottom:1px solid var(--line);padding:0 18px;display:flex;align-items:center;justify-content:space-between}.modal-title{font-size:16px;font-weight:700}.close-btn{border:0;background:transparent;font-size:22px;color:#98a2b3}.modal-bd{padding:16px 18px;overflow:auto}.modal-ft{height:64px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:center;gap:12px;flex:0 0 auto}
.tag-modal-layout{display:grid;grid-template-columns:58% 42%;min-height:490px;border:1px solid var(--line);border-radius:7px;overflow:hidden}.tag-left{border-right:1px solid var(--line);display:flex;flex-direction:column}.tag-search{padding:12px;border-bottom:1px solid var(--line);display:flex;gap:8px}.tag-list{overflow:auto;padding:0 12px}.tag-category{border-bottom:1px solid var(--line-soft)}.category-head{height:48px;display:flex;align-items:center;justify-content:space-between;cursor:pointer}.category-tags{display:flex;gap:10px;flex-wrap:wrap;padding:0 0 14px}.select-tag{height:30px;padding:0 11px;border:1px solid transparent;border-radius:4px;background:#f4f5f7;color:#475467;display:inline-flex;align-items:center;cursor:pointer}.select-tag.selected{background:var(--brand-soft);color:var(--brand);border-color:#c7dafe}.tag-right{background:#fbfcfe;display:flex;flex-direction:column}.selected-head{height:56px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.selected-body{padding:14px;display:flex;gap:8px;align-content:flex-start;flex-wrap:wrap;overflow:auto}.empty-state{width:100%;height:300px;display:flex;align-items:center;justify-content:center;color:#98a2b3}
.employee-layout{display:grid;grid-template-columns:240px 1fr 260px;gap:12px}.employee-panel{border:1px solid var(--line);border-radius:7px;min-height:420px;background:#fbfcfe}.employee-panel-hd{height:42px;padding:0 12px;border-bottom:1px solid var(--line);display:flex;align-items:center;font-weight:600}.employee-panel-bd{padding:10px;overflow:auto}.tree-row,.person-row{min-height:34px;padding:6px 8px;border-radius:5px;display:flex;align-items:center;justify-content:space-between;gap:8px}.tree-row.active{background:#eaf2ff;color:var(--brand)}.person-row:hover{background:#f3f6fa}.status-expired{font-size:12px;color:#d98200}.person-row.disabled{opacity:.58}.selected-person{padding:7px 9px;border-radius:5px;background:#eaf2ff;color:var(--brand);margin-bottom:6px}
.source-choice{display:grid;grid-template-columns:1fr 1fr;gap:14px}.choice-card{border:1px solid var(--line);border-radius:9px;padding:18px;cursor:pointer}.choice-card:hover{border-color:#a9c2ef;background:#f8fbff}.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:rgba(17,24,39,.94);color:#fff;padding:9px 14px;border-radius:7px;font-size:13px;opacity:0;pointer-events:none;transition:.2s;z-index:300}.toast.show{opacity:1}
@media(max-width:1240px){.slot-body{grid-template-columns:170px 1fr 200px}.review-layout{grid-template-columns:1fr 350px}.phone{width:335px}.copy-layout{grid-template-columns:390px 1fr}}
@media(max-width:980px){html,body{overflow:auto}.app{height:auto}.sidebar{display:none}.main{padding:0}.shell{height:auto;min-height:100vh;border-radius:0}.bottom-bar{left:0;position:fixed}.steps{grid-template-columns:repeat(4,1fr)}.step-desc{display:none}.copy-layout,.review-layout,.content-confirm{grid-template-columns:1fr}.slot-body{grid-template-columns:1fr}.phone-wrap{position:static}.workspace{padding-left:16px;padding-right:16px}.bottom-hint{display:none}.employee-layout{grid-template-columns:1fr}}

/* v18 layout refinements */
.table-actions{padding-top:14px}
.compact-copy-layout{grid-template-columns:minmax(0,1.45fr) minmax(390px,.85fr);gap:16px;align-items:stretch}
.copy-source-panel,.compact-editor-box{min-height:0}
.compact-generator{padding:14px}
.copy-config-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.compact-chips{margin:8px 0 10px}
.compact-goal{height:92px;min-height:92px;resize:none}
.candidate-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:11px 0 8px}
.compact-copy-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:0;max-height:none;overflow:visible;padding-right:0}
.compact-copy-list .copy-option{min-height:104px;padding:10px;display:flex;flex-direction:column;justify-content:space-between}
.compact-copy-list .copy-option-title{font-size:13px;align-items:center}
.compact-copy-list .copy-option-text{-webkit-line-clamp:2;font-size:12px;line-height:1.55;margin-top:5px}
.empty-copy-state{grid-column:1/-1;padding:34px 0;text-align:center;border:1px dashed #d7dfeb;border-radius:8px;background:#fbfcfe}
.compact-editor-box{padding:14px;display:flex;flex-direction:column}
.compact-final-editor{min-height:286px;height:286px;resize:none;flex:1}
.manual-source-editor{min-height:310px;resize:none}
.image-source-switch{margin-bottom:14px}
.existing-upload-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:12px}
.existing-image-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.existing-image-card{border:1px solid var(--line);border-radius:10px;background:#fff;overflow:hidden}
.existing-image-card .existing-card-head{height:44px;padding:0 12px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;background:#fbfcfe}
.existing-image-card .existing-card-body{padding:12px}
.existing-image-card .slot-result{height:190px}
.existing-empty{grid-column:1/-1;min-height:230px;border:1px dashed #c8d4e4;border-radius:10px;background:#fbfcfe;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#7d8b9f}
.review-layout{grid-template-columns:minmax(0,1fr) 410px;gap:20px}
.review-left{align-content:start}
.review-section .surface-bd{padding:14px}
.phone{width:390px;height:660px}
.moment{height:565px}
.workspace{padding-top:22px}
@media(max-width:1240px){.compact-copy-layout{grid-template-columns:minmax(0,1.25fr) minmax(360px,.75fr)}.compact-copy-list{grid-template-columns:repeat(2,minmax(0,1fr))}.existing-image-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.review-layout{grid-template-columns:minmax(0,1fr) 360px}.phone{width:345px}}


/* v19: context-aware flow and viewport-fit layout */
.step-strip{height:58px;padding:0 26px}
.steps{width:min(960px,100%);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}
.step{display:grid;grid-template-columns:28px max-content minmax(18px,1fr);align-items:center;gap:9px;min-width:0;color:#8a95a6}
.step:last-child{grid-template-columns:28px max-content}
.step::after{display:none!important}
.step-line{height:1px;background:#dce3ed;margin:0 14px 0 4px;min-width:18px}
.step.done .step-line{background:#8db5ff}
.step-label{font-size:14px;white-space:nowrap;position:relative;z-index:1}
.workspace{padding:16px 24px 82px}
.workspace.fit-view{overflow:hidden}
#step2Panel:not(.hidden),#step4Panel:not(.hidden){height:100%;display:flex;flex-direction:column;min-height:0}
#step2Panel .section-desc,#step4Panel .section-desc{margin-bottom:10px}
#step2Panel .source-switch{margin-bottom:10px;height:38px}
#step2Panel .source-tab{height:38px}
.compact-copy-layout{grid-template-columns:460px minmax(0,1fr);gap:14px;align-items:stretch;flex:1;min-height:0}
.copy-source-panel,.compact-editor-box{height:100%;overflow:hidden}
.compact-generator{height:100%;display:flex;flex-direction:column;padding:12px}
.copy-config-head{align-items:center}
.copy-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px}
.compact-chips{margin:0}
.count-picker{display:flex;align-items:center;gap:7px;white-space:nowrap}
.segmented-count{display:inline-flex;border:1px solid #d8dfeb;border-radius:7px;overflow:hidden;background:#fff}
.count-btn{width:30px;height:28px;border:0;border-right:1px solid #e7ebf1;background:#fff;color:#667085;padding:0}
.count-btn:last-child{border-right:0}.count-btn.active{background:var(--brand);color:#fff;font-weight:700}
.context-bar{margin:8px 0;padding:8px 10px;border:1px solid #dbe7fb;border-radius:7px;background:#f7faff;color:#52627a;font-size:12px;line-height:1.5}
.context-bar b{color:#2b5fb7}.context-chip{display:inline-flex;align-items:center;height:22px;padding:0 7px;border-radius:11px;background:#eaf2ff;color:var(--brand);margin:2px 4px 2px 0}
.compact-goal{height:68px;min-height:68px}
.candidate-head{margin:8px 0 6px}
.compact-copy-list{display:grid;grid-template-columns:1fr;grid-template-rows:repeat(5,minmax(0,1fr));gap:6px;flex:1;min-height:0;overflow:visible}
.compact-copy-list .copy-option{min-height:0;padding:8px 10px;display:grid;grid-template-columns:132px minmax(0,1fr);gap:10px;align-items:center}
.compact-copy-list .copy-option-title{font-size:12px;display:flex;flex-direction:column;align-items:flex-start;gap:4px}